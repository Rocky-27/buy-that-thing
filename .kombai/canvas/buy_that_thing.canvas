elative aspect-square mb-6 rounded-2xl overflow-hidden bg-white/5\" data-kid=\"148\">\n                        <img src=\"https://images.unsplash.com/photo-1641048930621-ab5d225ae5b0?auto=format&w=600&q=80&fit=crop\" alt=\"Product\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" data-kid=\"149\">\n                    </div>\n                    <div class=\"flex justify-between items-start mb-4\" data-kid=\"150\">\n                        <div data-kid=\"151\">\n                            <h5 class=\"font-bold text-lg mb-1 group-hover:text-var(--color-aqua) transition-colors\" data-kid=\"152\">Zen Studio</h5>\n                            <p class=\"text-white/40 text-sm\" data-kid=\"153\">Sand Grey / Limited</p>\n                        </div>\n                        <span class=\"text-var(--color-aqua) font-black text-xl\" data-kid=\"154\">£229</span>\n                    </div>\n                    <button class=\"mt-auto w-full py-3 rounded-xl border border-white/10 hover:border-var(--color-blue) hover:bg-var(--color-blue) transition-all font-bold flex items-center justify-center gap-2\" data-kid=\"155\">\n                        <i class=\"ti ti-plus\" data-kid=\"156\"></i> ADD TO CART\n                    </button>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-24 px-6\" data-kid=\"157\">\n        <div class=\"max-w-7xl mx-auto flex flex-col lg:flex-row gap-12 items-center\" data-kid=\"158\">\n            \n            <div class=\"flex-1 w-full rounded-[40px] overflow-hidden h-[600px] relative group\" data-kid=\"159\">\n                <img src=\"https://images.unsplash.com/photo-1683394380757-4f02e66185ee?auto=format&w=1200&q=80&fit=crop\" alt=\"Lifestyle Tech\" class=\"w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110\" data-kid=\"160\">\n                <div class=\"absolute inset-0 bg-gradient-to-t from-var(--color-navy) via-var(--color-navy)/20 to-transparent\" data-kid=\"161\"></div>\n                <div class=\"absolute bottom-12 left-12 max-w-md\" data-kid=\"162\">\n                    <span class=\"text-var(--color-aqua) font-bold tracking-[0.2em] uppercase text-xs mb-4 block drop-shadow-lg\" data-kid=\"163\">Limited Time Deals</span>\n                    <h3 class=\"text-5xl font-inter font-black mb-6 leading-tight drop-shadow-2xl\" data-kid=\"164\">Elite Performance. <br data-kid=\"165\"> Every Single Day.</h3>\n                    <p class=\"text-white text-lg mb-8 drop-shadow-lg\" data-kid=\"166\">Hand-selected gadgets that enhance your productivity and lifestyle. Uncompromising quality.</p>\n                    <button class=\"bg-var(--color-blue) text-white px-8 py-4 rounded-2xl font-black transition-all hover:bg-var(--color-aqua) hover:text-navy hover:shadow-[0_0_40px_rgba(0,112,255,0.6)] border border-white/20\" data-kid=\"167\">EXPLORE DEALS</button>\n                </div>\n            </div>\n\n            \n            <div class=\"flex-1 w-full flex flex-col gap-6\" data-kid=\"168\">\n                \n                <div class=\"group p-8 glass rounded-3xl border-l-[6px] border-var(--color-blue) flex items-center gap-6 transition-all duration-300 hover:bg-white/15\" data-kid=\"169\">\n                    <div class=\"w-16 h-16 rounded-2xl bg-var(--color-blue)/20 flex items-center justify-center text-var(--color-blue) group-hover:scale-110 transition-transform\" data-kid=\"170\">\n                        <i class=\"ti ti-shopping-bag-discount text-3xl\" data-kid=\"171\"></i>\n                    </div>\n                    <div class=\"flex-1\" data-kid=\"172\">\n                        <div class=\"flex items-center justify-between mb-1\" data-kid=\"173\">\n                            <h4 class=\"text-xl font-bold\" data-kid=\"174\">Flash Sale: 50% Off Wearables</h4>\n                            <span class=\"text-xs font-bold px-2 py-1 rounded bg-red-500/20 text-red-400\" data-kid=\"175\">HOT</span>\n                        </div>\n                        <p class=\"text-white/50\" data-kid=\"176\">Exclusive discount on smartwatches. Use code BTT50 at checkout.</p>\n                        <div class=\"mt-4 h-1.5 w-full bg-white/10 rounded-full overflow-hidden\" data-kid=\"177\">\n                            <div class=\"h-full bg-var(--color-blue) w-[75%]\" data-kid=\"178\"></div>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"group p-8 glass rounded-3xl border-l-[6px] border-var(--color-aqua) flex items-center gap-6 transition-all duration-300 hover:bg-white/15\" data-kid=\"179\">\n                    <div class=\"w-16 h-16 rounded-2xl bg-var(--color-aqua)/20 flex items-center justify-center text-var(--color-aqua) group-hover:scale-110 transition-transform\" data-kid=\"180\">\n                        <i class=\"ti ti-truck-delivery text-3xl\" data-kid=\"181\"></i>\n                    </div>\n                    <div class=\"flex-1\" data-kid=\"182\">\n                        <div class=\"flex items-center justify-between mb-1\" data-kid=\"183\">\n                            <h4 class=\"text-xl font-bold\" data-kid=\"184\">Free Next-Day Shipping</h4>\n                            <span class=\"text-xs font-bold px-2 py-1 rounded bg-var(--color-aqua)/20 text-var(--color-aqua)\" data-kid=\"185\">ACTIVE</span>\n                        </div>\n                        <p class=\"text-white/50\" data-kid=\"186\">On all orders over £50 across mainland UK. Limited time offer.</p>\n                    </div>\n                </div>\n\n                \n                <div class=\"group p-8 glass rounded-3xl border-l-[6px] border-white/30 flex items-center gap-6 transition-all duration-300 hover:bg-white/15\" data-kid=\"187\">\n                    <div class=\"w-16 h-16 rounded-2xl bg-white/10 flex items-center justify-center text-white group-hover:scale-110 transition-transform\" data-kid=\"188\">\n                        <i class=\"ti ti-gift text-3xl\" data-kid=\"189\"></i>\n                    </div>\n                    <div class=\"flex-1\" data-kid=\"190\">\n                        <h4 class=\"text-xl font-bold\" data-kid=\"191\">Refer a Friend, Get £20</h4>\n                        <p class=\"text-white/50\" data-kid=\"192\">Share your unique link and earn credit for every successful purchase.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-24 px-6 relative overflow-hidden\" data-kid=\"193\">\n        \n        <div class=\"absolute -top-40 -right-40 w-96 h-96 bg-var(--color-blue)/10 rounded-full blur-[100px]\" data-kid=\"194\"></div>\n        <div class=\"absolute -bottom-40 -left-40 w-96 h-96 bg-var(--color-aqua)/10 rounded-full blur-[100px]\" data-kid=\"195\"></div>\n\n        <div class=\"max-w-5xl mx-auto glass p-12 md:p-20 rounded-[40px] text-center relative z-10 border border-white/10\" data-kid=\"196\">\n            <h3 class=\"text-4xl md:text-5xl font-inter font-black mb-6\" data-kid=\"197\">Stay Ahead of the Curve</h3>\n            <p class=\"text-white/70 text-xl mb-10 max-w-2xl mx-auto\" data-kid=\"198\">Get early access to drops, exclusive discounts, and professional tech reviews delivered to your inbox.</p>\n            <form class=\"flex flex-col md:flex-row items-center gap-4 max-w-2xl mx-auto group/form\" data-kid=\"199\">\n                <div class=\"relative w-full\" data-kid=\"200\">\n                    <input type=\"email\" placeholder=\"Your email address\" class=\"w-full bg-white/5 border border-white/10 rounded-2xl px-8 py-5 outline-none focus:border-var(--color-aqua) focus:bg-white/10 transition-all text-white text-lg group-focus-within/form:shadow-[0_0_20px_rgba(125,249,255,0.1)]\" data-kid=\"201\">\n                </div>\n                <button class=\"w-full md:w-aut