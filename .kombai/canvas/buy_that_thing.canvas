/span>\n            <div class=\"w-[3px] h-12 bg-gradient-to-b from-[#FF00FF] via-[#00FFFF] to-transparent rounded-full\" data-kid=\"41\"></div>\n        </div>\n    </section>\n\n    \n    <section id=\"collections\" class=\"relative z-10 py-24 overflow-hidden\" data-kid=\"42\">\n        <div class=\"max-w-7xl mx-auto px-6 lg:px-12\" data-kid=\"43\">\n            <div class=\"flex flex-col items-center mb-16\" data-kid=\"44\">\n                <h2 class=\"font-['Bricolage_Grotesque'] text-6xl lg:text-7xl font-black text-white italic uppercase tracking-tighter text-center\" data-kid=\"45\">\n                    Pick Your <span class=\"text-[#00FFFF]\" data-kid=\"46\">Vibe.</span>\n                </h2>\n                <div class=\"w-24 h-2 bg-[#FF00FF] mt-4 transform -rotate-2\" data-kid=\"47\"></div>\n            </div>\n\n            <div class=\"flex flex-wrap justify-center gap-10\" data-kid=\"48\">\n                <div class=\"float-island\" data-kid=\"49\">\n                    <a href=\"#\" class=\"bg-white border-[4px] border-[#0B0B0F] px-10 py-6 rounded-full flex items-center gap-5 shadow-[10px_10px_0px_#FF00FF] hover:shadow-none hover:translate-x-2 hover:translate-y-2 transition-all\" data-kid=\"50\">\n                        <span class=\"text-4xl\" data-kid=\"51\">🕹️</span>\n                        <span class=\"font-['Bricolage_Grotesque'] font-black text-2xl text-[#0B0B0F] italic uppercase\" data-kid=\"52\">Gaming Gear</span>\n                    </a>\n                </div>\n                <div class=\"float-island-delayed mt-12\" data-kid=\"53\">\n                    <a href=\"#\" class=\"bg-white border-[4px] border-[#0B0B0F] px-10 py-6 rounded-full flex items-center gap-5 shadow-[10px_10px_0px_#00FFFF] hover:shadow-none hover:translate-x-2 hover:translate-y-2 transition-all\" data-kid=\"54\">\n                        <span class=\"text-4xl\" data-kid=\"55\">🛁</span>\n                        <span class=\"font-['Bricolage_Grotesque'] font-black t