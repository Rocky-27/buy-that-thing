tracking-tighter\" data-kid=\"70\">Trending Now</h3>\n                </div>\n                <a href=\"#\" class=\"group flex items-center gap-3 text-white font-black text-xl italic hover:text-[#00FFFF] transition-colors\" data-kid=\"71\">\n                    VIEW ALL <i class=\"ti ti-arrow-right transition-transform group-hover:translate-x-2\" data-kid=\"72\"></i>\n                </a>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-16\" data-kid=\"73\">\n                \n                <div class=\"space-y-16\" data-kid=\"74\">\n                    \n                    <div class=\"bg-white border-[4px] border-[#0B0B0F] rounded-3xl overflow-hidden shadow-[12px_12px_0px_#0B0B0F] group hover:-rotate-1 transition-all\" data-kid=\"75\">\n                        <div class=\"aspect-[3/4] overflow-hidden bg-gray-100 relative\" data-kid=\"76\">\n                            <img src=\"https://images.unsplash.com/photo-1568614213442-9023b31ca184?auto=format&w=600&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\" decoding=\"async\" data-kid=\"77\">\n                            <div class=\"absolute top-4 left-4 bg-[#FF00FF] text-[#0B0B0F] font-black px-4 py-1 rounded-full text-sm uppercase italic\" data-kid=\"78\">HOT DROP</div>\n                        </div>\n                        <div class=\"p-8\" data-kid=\"79\">\n                            <div class=\"flex justify-between items-start gap-4 mb-4\" data-kid=\"80\">\n                                <h4 class=\"font-['Bricolage_Grotesque'] font-black text-2xl text-[#0B0B0F] uppercase italic leading-none\" data-kid=\"81\">Airdrop Pods Pro</h4>\n                                <span class=\"text-[#FF00FF] font-black text-2xl italic tracking-tighter leading-none\" data-kid=\"82\">£59.99</span>\n                            </div>\n                            <p class=\"text-gray-500 font-medium mb-8 leading-snug\" data-kid=\"83\">Crystal audio with TikTok's favorite aesthetic design.</p>\n                            <button class=\"w-full bg-[#0B0B0F] text-white font-black py-4 rounded-xl text-xl hover:bg-[#FF00FF] transition-all transform hover:scale-102 active:scale-98\" data-kid=\"84\">ADD TO CART</button>\n                        </div>\n                    </div>\n                    \n                    <div class=\"bg-white border-[4px] border-[#0B0B0F] rounded-3xl overflow-hidden shadow-[12px_12px_0px_#FF00FF] group hover:rotate-1 transition-all\" data-kid=\"85\">\n                        <div class=\"aspect-square overflow-hidden bg-gray-100\" data-kid=\"86\">\n                            <img src=\"https://images.unsplash.com/photo-1622805199349-ada0338f7c0b?auto=format&w=600&q=80&fit=crop\" class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-700\" decoding=\"async\" data-kid=\"87\">\n                        </div>\n                        <div class=\"p-8\" data-kid=\"88\">\n                            <h4 class=\"font-['Bricolage_Grotesque'] font-black text-xl text-[#0B0B0F] uppercase italic\" data-kid=\"89\">Neon Logi Mouse</h4>\n                            <div class=\"mt-6 flex justify-between items-center\" data-kid=\"90\">\n                                <span class=\"text-[#FF00FF] font-black text-xl italic tracking-tighter\" data-kid=\"91\">£34.99</span>\n                                <button class=\"w-14 h-14 bg-[#0B0B0F] text-white rounded-2xl flex items-center justify-center hover:bg-[#00FFFF] transition-all shadow-[4px_4px_0px_#0B0B0F] hover:shadow-none active:scale-90\" data-kid=\"92\"><i class=\"ti ti-plus text-2xl\" data-kid=\"93\"></i></button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"space-y-16 lg:mt-24\" data-kid=\"94\">\n                    \n                    <div class=\"