      "html": "\n<style data-kid=\"0\">\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=DM+Sans:wght@400;500;700&display=swap');\n\n:root {\n  --color-navy: #001933;\n  --color-blue: #0070FF;\n  --color-aqua: #7DF9FF;\n}\n\nbody {\n  margin: 0;\n  padding: 0;\n  background-color: var(--color-navy);\n  color: white;\n  font-family: 'DM Sans', sans-serif;\n  overflow-x: hidden;\n}\n\n.font-inter { font-family: 'Inter', sans-serif; }\n\n.glass {\n  background: rgba(255, 255, 255, 0.1);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid rgba(255, 255, 255, 0.2);\n}\n\n.glass-dark {\n  background: rgba(0, 25, 51, 0.6);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n}\n\n.gradient-border-container {\n  position: relative;\n  z-index: 1;\n}\n\n.gradient-border-bg {\n  position: absolute;\n  inset: -2px;\n  border-radius: inherit;\n  background: linear-gradient(135deg, var(--color-blue), var(--color-aqua));\n  z-index: -1;\n  opacity: 0.2;\n  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.group:hover .gradient-border-bg {\n  opacity: 1;\n  inset: -4px;\n  filter: blur(2px);\n}\n\n.scrollbar-hide::-webkit-scrollbar {\n  display: none;\n}\n.scrollbar-hide {\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}\n\n@keyframes float {\n  0% { transform: translateY(0px) rotate(-6deg); }\n  50% { transform: translateY(-20px) rotate(-4deg); }\n  100% { transform: translateY(0px) rotate(-6deg); }\n}\n\n.animate-float {\n  animation: float 6s ease-in-out infinite;\n}\n\n.nav-link {\n  position: relative;\n  font-weight: 500;\n}\n.nav-link::after {\n  content: '';\n  position: absolute;\n  width: 0;\n  height: 2px;\n  bottom: -4px;\n  left: 0;\n  background-color: var(--color-aqua);\n  transition: width 0.3s ease;\n}\n.nav-link:hover::after {\n  width: 100%;\n}\n</style>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"1\">\n\n\n<nav class=\"absolute top-0 left-0 right-0 z-50 px-6 py-4\" data-kid=\"2\">\n    <div class=\"max-w-7xl mx-auto flex items-center justify-between glass rounded-2xl px-8 py-3\" data-kid=\"3\">\n        \n        <div class=\"flex items-center gap-3 group cursor-pointer\" data-kid=\"4\">\n            <div class=\"relative w-12 h-12 flex items-center justify-center\" data-kid=\"5\">\n                <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/nested-hexagons.svg\" class=\"w-full h-full brightness-0 invert opacity-100 group-hover:scale-110 transition-transform\" style=\"filter: drop-shadow(0 0 10px rgba(0, 112, 255, 0.8));\" alt=\"Hexagon\" data-kid=\"6\">\n                <span class=\"absolute text-[11px] font-black font-inter text-white tracking-tighter\" data-kid=\"7\">BTT</span>\n            </div>\n            <span class=\"text-xl font-inter font-black tracking-widest hidden md:block group-hover:text-var(--color-aqua) transition-colors\" data-kid=\"8\">BUY THAT THING</span>\n        </div>\n\n        \n        <div class=\"hidden lg:flex items-center gap-8 text-sm uppercase tracking-widest\" data-kid=\"9\">\n            <a href=\"#\" class=\"nav-link text-white\" data-kid=\"10\">Home</a>\n            <a href=\"#\" class=\"nav-link text-white/70 hover:text-white transition-colors\" data-kid=\"11\">Tech</a>\n            <a href=\"#\" class=\"nav-link text-white/70 hover:text-white transition-colors\" data-kid=\"12\">Wearables</a>\n            <a href=\"#\" class=\"nav-link text-white/70 hover:text-white transition-colors\" data-kid=\"13\">Accessories</a>\n        </div>\n\n        \n        <div class=\"flex items-center gap-6\" data-kid=\"14\">\n            <button class=\"text-white/70 hover:text-white transition-colors\" data-kid=\"15\"><i class=\"ti ti-search text-xl\" data-kid=\"16\"></i></button>\n            <div class=\"relative\" data-kid=\"17\">\n                <button class=\"text-white/70 hover:text-white transition-colors\" data-kid=\"18\"><i class=\"ti ti-shopping-bag text-xl\" data-kid=\"19\"></i></button>\n                <span class=\"absolute -top-1 -right-2 w-4 h-4 bg-var(--color-blue) text-[10px] flex items-center justify-center rounded-full font-bold\" data-kid=\"20\">2</span>\n            </div>\n            <button class=\"bg-var(--color-blue) hover:bg-blue-600 text-white px-5 py-2 rounded-xl text-sm font-bold transition-all transform hover:scale-105 shadow-[0_0_15px_rgba(0,112,255,0.3)]\" data-kid=\"21\">\n                LOGIN\n            </button>\n        </div>\n    </div>\n</nav>\n\n<main class=\"pt-24\" data-kid=\"22\">\n    \n    <section class=\"relative px-6 py-20 min-h-[850px] flex items-center justify-center overflow-hidden\" data-kid=\"23\">\n        \n        <div class=\"absolute -top-[10%] -left-[10%] w-[500px] h-[500px] bg-var(--color-blue) opacity-20 rounded-full blur-[120px]\" data-kid=\"24\"></div>\n        <div class=\"absolute bottom-[10%] -right-[10%] w-[600px] h-[600px] bg-var(--color-aqua) opacity-10 rounded-full blur-[150px]\" data-kid=\"25\"></div>\n        \n        \n        <div class=\"absolute top-1/4 left-1/2 w-40 h-40 bg-pink-500 opacity-10 rounded-full blur-[80px]\" data-kid=\"26\"></div>\n\n        <div class=\"max-w-7xl mx-auto w-full relative z-10\" data-kid=\"27\">\n            <div class=\"glass p-10 md:p-20 rounded-[40px] flex flex-col lg:flex-row items-center gap-16 border border-white/20\" data-kid=\"28\">\n                <div class=\"flex-1 text-center lg:text-left\" data-kid=\"29\">\n                    <div class=\"inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 mb-8\" data-kid=\"30\">\n                        <span class=\"w-2 h-2 rounded-full bg-var(--color-aqua) animate-pulse\" data-kid=\"31\"></span>\n                        <span class=\"text-xs font-bold tracking-widest text-var(--color-aqua) uppercase\" data-kid=\"32\">New Generation Wireless</span>\n                    </div>\n                    <h1 class=\"text-white text-6xl md:text-7xl lg:text-8xl font-inter font-black mb-8 leading-[1.05] tracking-tighter\" data-kid=\"33\">\n                        Find Exactly <br data-kid=\"34\"> What You Need.\n                    </h1>\n                    <p class=\"text-white/60 text-lg md:text-xl mb-10 max-w-xl mx-auto lg:mx-0 leading-relaxed\" data-kid=\"35\">\n                        Experience audio like never before. The all-new Sonic Pro features hybrid ANC and 60-hour battery life. Designed for the professionals.\n                    </p>\n                    <div class=\"flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4\" data-kid=\"36\">\n                        <button class=\"w-full sm:w-auto bg-var(--color-blue) hover:bg-blue-600 text-white px-10 py-5 rounded-2xl font-bold text-lg transition-all transform hover:scale-105 shadow-[0_20px_40px_rgba(0,112,255,0.4)]\" data-kid=\"37\">\n                            Shop The Drop\n                        </button>\n                        <button class=\"w-full sm:w-auto glass hover:bg-white/20 text-white px-10 py-5 rounded-2xl font-bold text-lg transition-all\" data-kid=\"38\">\n                            Learn More\n                        </button>\n                    </div>\n                </div>\n\n                <div class=\"flex-1 relative\" data-kid=\"39\">\n                    <div class=\"relative z-10 animate-float\" data-kid=\"40\">\n                        <img src=\"https://images.unsplash.com/photo-1520170350707-b2da59970118?auto=format&w=800&q=80&fit=crop\" alt=\"Premium Headphones\" class=\"w-full h-auto drop-shadow-[0_50px_100px_rgba(0,0,0,0.6)]\" decoding=\"async\" loading=\"lazy\" data-kid=\"41\">\n                    </div>\n                    \n                    <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-var(--color-blue)/20 blur-[100px] rounded-full -z-10\" data-kid=\"42\"></div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-12 border-y border-white/10 bg-white/2 overflow-hidden backdrop-blur-sm\" data-kid=\"43\">\n        <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"44\">\n            <div class=\"flex flex-wrap items-center justify-center gap-12 md:gap-24 opacity-40 grayscale hover:grayscale-0 transition-all duration-700\" data-kid=\"45\">\n                <span class=\"font-inter font-black text-2xl tracking-tighter\" data-kid=\"46\">SONY</span>\n                <span class=\"font-inter font-black text-2xl tracking-tighter\" data-kid=\"47\">BOSE</span>\n                <span class=\"font-inter font-black text-2xl tracking-tighter\" data-kid=\"48\">APPLE</span>\n                <span class=\"font-inter font-black text-2xl tracking-tighter\" data-kid=\"49\">SAMSUNG</span>\n                <span class=\"font-inter font-black text-2xl tracking-tighter\" data-kid=\"50\">JBL</span>\n                <span class=\"font-inter font-black text-2xl tracking-tighter\" data-kid=\"51\">BEATS</span>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-24 px-6 relative overflow-hidden\" data-kid=\"52\">\n        \n        <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full opacity-30 blur-3xl pointer-events-none\" data-kid=\"53\">\n            <img src=\"https://images.unsplash.com/photo-1550859492-d5da9d8e45f3?auto=format&w=1200&q=80&fit=crop\" class=\"w-full\" alt=\"Refraction\" data-kid=\"54\">\n        </div>\n\n        <div class=\"max-w-7xl mx-auto relative z-10\" data-kid=\"55\">\n            <div class=\"flex flex-col md:flex-row items-end justify-between mb-16 gap-6\" data-kid=\"56\">\n                <div data-kid=\"57\">\n                    <h2 class=\"text-var(--color-aqua) font-bold tracking-widest uppercase text-sm mb-4\" data-kid=\"58\">Curated Categories</h2>\n                    <h3 class=\"text-4xl md:text-5xl font-inter font-black\" data-kid=\"59\">Explore Collections</h3>\n                </div>\n                <button class=\"group flex items-center gap-2 text-white/60 hover:text-white transition-colors\" data-kid=\"60\">\n                    View All Categories <i class=\"ti ti-arrow-right group-hover:translate-x-2 transition-transform\" data-kid=\"61\"></i>\n                </button>\n            </div>\n\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\" data-kid=\"62\">\n                \n                <div class=\"group relative h-[450px] rounded-[32px] overflow-hidden cursor-pointer\" data-kid=\"63\">\n                    <div class=\"absolute inset-0 glass transition-all duration-500 group-hover:bg-white/15\" data-kid=\"64\"></div>\n                    <div class=\"relative z-10 h-full p-10 flex flex-col justify-between\" data-kid=\"65\">\n                        <div class=\"w-20 h-20 rounded-3xl bg-var(--color-blue)/20 flex items-center justify-center text-var(--color-blue) border border-var(--color-blue)/30 transition-all duration-500 group-hover:bg-var(--color-blue) group-hover:text-white group-hover:shadow-[0_0_40px_rgba(0,112,255,0.6)]\" data-kid=\"66\">\n                            <i class=\"ti ti-headphones text-4xl\" data-kid=\"67\"></i>\n                        </div>\n                        <div data-kid=\"68\">\n                            <h4 class=\"text-3xl font-inter font-black mb-2 group-hover:text-var(--color-aqua) transition-colors\" data-kid=\"69\">Audio Gear</h4>\n                            <p class=\"text-white/60 mb-6 group-hover:text-white transition-colors\" data-kid=\"70\">Immersive sound systems and headphones.</p>\n                            <div class=\"w-12 h-1 bg-var(--color-blue) transition-all duration-500 group-hover:w-full group-hover:shadow-[0_0_15px_rgba(0,112,255,0.8)]\" data-kid=\"71\"></div>\n                        </div>\n                    </div>\n                    <div class=\"absolute -bottom-10 -right-10 w-48 h-48 bg-var(--color-blue)/20 rounded-full blur-[60px] transition-all duration-700 group-hover:scale-150 group-hover:opacity-60\" data-kid=\"72\"></div>\n                </div>\n\n                \n                <div class=\"group relative h-[450px] rounded-[32px] overflow-hidden cursor-pointer\" data-kid=\"73\">\n                    <div class=\"absolute inset-0 glass transition-all duration-500 group-hover:bg-white/15\" data-kid=\"74\"></div>\n                    <div class=\"relative z-10 h-full p-10 flex flex-col justify-between\" data-kid=\"75\">\n                        <div class=\"w-20 h-20 rounded-3xl bg-var(--color-aqua)/20 flex items-center justify-center text-var(--color-aqua) border border-var(--color-aqua)/30 transition-all duration-500 group-hover:bg-var(--color-aqua) group-hover:text-navy group-hover:shadow-[0_0_40px_rgba(125,249,255,0.6)]\" data-kid=\"76\">\n                            <i class=\"ti ti-device-watch text-4xl\" data-kid=\"77\"></i>\n                        </div>\n                        <div data-kid=\"78\">\n                            <h4 class=\"text-3xl font-inter font-black mb-2 group-hover:text-var(--color-blue) transition-colors\" data-kid=\"79\">Wearables</h4>\n                            <p class=\"text-white/60 mb-6 group-hover:text-white transition-colors\" data-kid=\"80\">Smartwatches and fitness tracking tech.</p>\n                            <div class=\"w-12 h-1 bg-var(--color-aqua) transition-all duration-500 group-hover:w-full group-hover:shadow-[0_0_15px_rgba(125,249,255,0.8)]\" data-kid=\"81\"></div>\n                        </div>\n                    </div>\n                    <div class=\"absolute -top-10 -left-10 w-48 h-48 bg-var(--color-aqua)/10 rounded-full blur-[60px] transition-all duration-700 group-hover:scale-150 group-hover:opacity-60\" data-kid=\"82\"></div>\n                </div>\n\n                \n                <div class=\"group relative h-[450px] rounded-[32px] overflow-hidden cursor-pointer\" data-kid=\"83\">\n                    <div class=\"absolute inset-0 glass transition-all duration-500 group-hover:bg-white/15\" data-kid=\"84\"></div>\n                    <div class=\"relative z-10 h-full p-10 flex flex-col justify-between\" data-kid=\"85\">\n                        <div class=\"w-20 h-20 rounded-3xl bg-white/10 flex items-center justify-center text-white border border-white/20 transition-all duration-500 group-hover:bg-white group-hover:text-navy group-hover:shadow-[0_0_40px_rgba(255,255,255,0.6)]\" data-kid=\"86\">\n                            <i class=\"ti ti-smart-home text-4xl\" data-kid=\"87\"></i>\n                        </div>\n                        <div data-kid=\"88\">\n                            <h4 class=\"text-3xl font-inter font-black mb-2 group-hover:text-var(--color-aqua) transition-colors\" data-kid=\"89\">Modern Living</h4>\n                            <p class=\"text-white/60 mb-6 group-hover:text-white transition-colors\" data-kid=\"90\">Home automation and smart devices.</p>\n                            <div class=\"w-12 h-1 bg-white transition-all duration-500 group-hover:w-full\" data-kid=\"91\"></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-24 bg-white/2 relative group/section\" data-kid=\"92\">\n        <div class=\"max-w-7xl mx-auto px-6 mb-12 flex items-end justify-between\" data-kid=\"93\">\n            <div class=\"text-left\" data-kid=\"94\">\n                <h2 class=\"text-4xl md:text-5xl font-inter font-black mb-4\" data-kid=\"95\">Trending Now</h2>\n                <p class=\"text-white/50 max-w-2xl\" data-kid=\"96\">The most wanted tech essentials in the UK, updated daily.</p>\n            </div>\n            <div class=\"flex gap-3 mb-2\" data-kid=\"97\">\n                <button class=\"w-12 h-12 rounded-full glass hover:bg-var(--color-blue) flex items-center justify-center transition-all\" data-kid=\"98\">\n                    <i class=\"ti ti-chevron-left text-xl\" data-kid=\"99\"></i>\n                </button>\n                <button class=\"w-12 h-12 rounded-full glass hover:bg-var(--color-blue) flex items-center justify-center transition-all\" data-kid=\"100\">\n                    <i class=\"ti ti-chevron-right text-xl\" data-kid=\"101\"></i>\n                </button>\n            </div>\n        </div>\n\n        <div class=\"flex gap-8 overflow-x-auto px-6 lg:px-[calc((100vw-1280px)/2+24px)] py-10 scrollbar-hide\" data-kid=\"102\">\n            \n            <div class=\"group relative flex-shrink-0 w-[350px] rounded-[24px] gradient-border-container overflow-hidden transition-all duration-500 hover:-translate-y-4\" data-kid=\"103\">\n                <div class=\"gradient-border-bg\" data-kid=\"104\"></div>\n                <div class=\"bg-var(--color-navy) h-full p-6 flex flex-col rounded-[22px] m-[1px]\" data-kid=\"105\">\n                    <div class=\"relative aspect-square mb-6 rounded-2xl overflow-hidden bg-white/5\" data-kid=\"106\">\n                        <img src=\"https://images.unsplash.com/photo-1599669454699-248893623440?auto=format&w=600&q=80&fit=crop\" alt=\"Product\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" data-kid=\"107\">\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"108\"></div>\n                        <button class=\"absolute bottom-4 left-1/2 -translate-x-1/2 bg-var(--color-blue) text-white text-xs font-bold py-2 px-6 rounded-full opacity-0 group-hover:opacity-100 translate-y-4 group-hover:translate-y-0 transition-all duration-300\" data-kid=\"109\">QUICK VIEW</button>\n                    </div>\n                    <div class=\"flex justify-between items-start mb-4\" data-kid=\"110\">\n                        <div data-kid=\"111\">\n                            <h5 class=\"font-bold text-lg mb-1 group-hover:text-var(--color-aqua) transition-colors\" data-kid=\"112\">Sonic Pro X1</h5>\n                            <p class=\"text-white/40 text-sm\" data-kid=\"113\">Space Black Edition</p>\n                        </div>\n                        <span class=\"text-var(--color-aqua) font-black text-xl\" data-kid=\"114\">£199</span>\n                    </div>\n                    <button class=\"mt-auto w-full py-3 rounded-xl border border-white/10 hover:border-var(--color-blue) hover:bg-var(--color-blue) hover:shadow-[0_0_20px_rgba(0,112,255,0.4)] transition-all font-bold flex items-center justify-center gap-2\" data-kid=\"115\">\n                        <i class=\"ti ti-plus\" data-kid=\"116\"></i> ADD TO CART\n                    </button>\n                </div>\n            </div>\n\n            \n            <div class=\"group relative flex-shrink-0 w-[350px] rounded-[24px] gradient-border-container overflow-hidden transition-all duration-500 hover:-translate-y-4\" data-kid=\"117\">\n                <div class=\"gradient-border-bg\" data-kid=\"118\"></div>\n                <div class=\"bg-var(--color-navy) h-full p-6 flex flex-col rounded-[22px] m-[1px]\" data-kid=\"119\">\n                    <div class=\"relative aspect-square mb-6 rounded-2xl overflow-hidden bg-white/5\" data-kid=\"120\">\n                        <img src=\"https://images.unsplash.com/photo-1612858249937-1cc0852093dd?auto=format&w=600&q=80&fit=crop\" alt=\"Product\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" data-kid=\"121\">\n                        <div class=\"absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"122\"></div>\n                        