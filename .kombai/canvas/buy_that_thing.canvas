te/70\" data-kid=\"238\">\n                    <li data-kid=\"239\"><a href=\"#\" class=\"hover:text-var(--color-aqua) transition-colors\" data-kid=\"240\">Shipping Information</a></li>\n                    <li data-kid=\"241\"><a href=\"#\" class=\"hover:text-var(--color-aqua) transition-colors\" data-kid=\"242\">Returns & Exchanges</a></li>\n                    <li data-kid=\"243\"><a href=\"#\" class=\"hover:text-var(--color-aqua) transition-colors\" data-kid=\"244\">Track Your Order</a></li>\n                    <li data-kid=\"245\"><a href=\"#\" class=\"hover:text-var(--color-aqua) transition-colors\" data-kid=\"246\">Terms of Service</a></li>\n                    <li data-kid=\"247\"><a href=\"#\" class=\"hover:text-var(--color-aqua) transition-colors\" data-kid=\"248\">Privacy Policy</a></li>\n                </ul>\n            </div>\n\n            \n            <div data-kid=\"249\">\n                <h5 class=\"text-lg font-bold mb-8 font-inter text-white\" data-kid=\"250\">Contact Us</h5>\n                <ul class=\"flex flex-col gap-6\" data-kid=\"251\">\n                    <li class=\"flex items-center gap-4 text-white/70\" data-kid=\"252\">\n                        <i class=\"ti ti-mail text-xl text-var(--color-aqua)\" data-kid=\"253\"></i>\n                        <span class=\"hover:text-white transition-colors cursor-pointer\" data-kid=\"254\">support@buythatthing.co.uk</span>\n                    </li>\n                    <li class=\"flex items-center gap-4 text-white/70\" data-kid=\"255\">\n                        <i class=\"ti ti-phone text-xl text-var(--color-aqua)\" data-kid=\"256\"></i>\n                        <span class=\"hover:text-white transition-colors cursor-pointer\" data-kid=\"257\">+44 (0) 20 8123 4567</span>\n                    </li>\n                    <li class=\"flex items-center gap-4 text-white/70\" data-kid=\"258\">\n                        <i class=\"ti ti-map-pin text-xl text-var(--color-aqua)\" data-kid=\"259\"></i>\n                        <span data-kid=\"260\">London, United Kingdom</span>\n                    </li>\n                </ul>\n            </div>\n        </div>\n\n        \n        <div class=\"flex flex-col md:flex-row items-center justify-between pt-10 border-t border-white/5 text-white/30 text-xs\" data-kid=\"261\">\n            <p data-kid=\"262\">&copy; 2024 Buy That Thing (BTT). All rights reserved. Crafted for Professionals.</p>\n            <div class=\"flex items-center gap-6 mt-6 md:mt-0 opacity-50\" data-kid=\"263\">\n                <i class=\"ti ti-brand-visa text-3xl\" data-kid=\"264\"></i>\n                <i class=\"ti ti-brand-mastercard text-3xl\" data-kid=\"265\"></i>\n                <i class=\"ti ti-brand-paypal text-3xl\" data-kid=\"266\"></i>\n                <i class=\"ti ti-brand-apple-pay text-3xl\" data-kid=\"267\"></i>\n            </div>\n        </div>\n    </div>\n</footer>\n",
