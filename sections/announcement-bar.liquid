{% if section.settings.show_announcement %}
  <div class="announcement-bar">
    <div class="page-width announcement-bar__inner">
      <p>{{ section.settings.text }}</p>
      {% if section.settings.link_label != blank and section.settings.link != blank %}
        <a href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Free shipping on every order | New offers added regularly"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View offers"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ]
}
{% endschema %}
