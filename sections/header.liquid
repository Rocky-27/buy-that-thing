{% assign collections_index_url = '/collections' %}
<header class="site-header" data-header>
  <div class="page-width header-main">
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span></span>
      <span></span>
      <span></span>
      Menu
    </button>

    <a class="brand-mark" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      <span class="brand-mark__badge">B</span>
      <span class="brand-mark__text">buy that thing</span>
    </a>

    <form class="site-search" action="{{ routes.search_url }}" method="get" role="search" data-predictive-search-form data-predictive-search-url="{{ routes.predictive_search_url }}">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.search_placeholder }}" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" aria-autocomplete="list" aria-expanded="false" aria-controls="predictive-search-desktop" data-predictive-search-input>
      <button type="submit" aria-label="Search">Search</button>
      <div class="site-search__results" id="predictive-search-desktop" data-predictive-search-results hidden></div>
    </form>

    <div class="site-header__actions">
      <a href="{{ routes.account_url }}" aria-label="Account">
        <span class="header-action__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <circle cx="12" cy="8" r="3.5" fill="none" stroke="currentColor" stroke-width="1.8"/>
            <path d="M5.5 18.25a6.5 6.5 0 0 1 13 0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"/>
          </svg>
        </span>
        <span>Sign in</span>
      </a>
      <a class="cart-pill" href="{{ routes.cart_url }}" aria-label="Basket">
        <span class="header-action__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M7 8.25h10.5l-1.15 8H8.15L7 8.25Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.8"/>
            <path d="M9.5 8.25a2.5 2.5 0 0 1 5 0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"/>
          </svg>
        </span>
        <span>Basket</span>
        <strong>{{ cart.item_count }}</strong>
      </a>
    </div>
  </div>

  <div class="header-services">
    <div class="page-width header-services__inner">
      <span><strong>🚚</strong> Free delivery on every order</span>
      <span><strong>✨</strong> Big finds without the faff</span>
      <span><strong>💬</strong> Simple support if plans change</span>
      <span><strong>🔒</strong> Secure checkout</span>
    </div>
  </div>

  <div class="header-nav-wrap">
    <nav class="page-width site-nav" aria-label="Primary">
      <a class="site-nav__all" href="{{ collections_index_url }}">Shop by category</a>
      {% for link in section.settings.menu.links %}
        {% assign normalized_title = link.title | downcase %}
        <a href="{% if normalized_title contains 'catalog' or normalized_title contains 'collection' %}{{ collections_index_url }}{% else %}{{ link.url }}{% endif %}">{{ link.title }}</a>
      {% endfor %}
      <a class="site-nav__sale" href="/collections/special-offer">Sale</a>
    </nav>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <div class="page-width mobile-menu__inner">
      <form class="site-search site-search--mobile" action="{{ routes.search_url }}" method="get" role="search" data-predictive-search-form data-predictive-search-url="{{ routes.predictive_search_url }}">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.search_placeholder }}" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" aria-autocomplete="list" aria-expanded="false" aria-controls="predictive-search-mobile" data-predictive-search-input>
        <button type="submit" aria-label="Search">Search</button>
        <div class="site-search__results" id="predictive-search-mobile" data-predictive-search-results hidden></div>
      </form>
      <a href="{{ collections_index_url }}">Shop by category</a>
      {% for link in section.settings.menu.links %}
        {% assign normalized_title = link.title | downcase %}
        <a href="{% if normalized_title contains 'catalog' or normalized_title contains 'collection' %}{{ collections_index_url }}{% else %}{{ link.url }}{% endif %}">{{ link.title }}</a>
      {% endfor %}
      <a href="{{ routes.account_url }}">Account</a>
      <a href="{{ routes.cart_url }}">Basket ({{ cart.item_count }})</a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search clever home finds, garden wins, gadgets..."
    }
  ]
}
{% endschema %}
