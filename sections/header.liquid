<header class="site-header" data-header>
  <div class="page-width site-header__inner">
    <a class="brand-mark" href="{{ routes.root_url }}">
      <span class="brand-mark__badge">BTT</span>
      <span class="brand-mark__text">{{ shop.name }}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </nav>

    <div class="site-header__actions">
      <a href="{{ routes.search_url }}" aria-label="Search">Search</a>
      <a href="{{ routes.account_url }}" aria-label="Account">Account</a>
      <a class="cart-pill" href="{{ routes.cart_url }}" aria-label="Cart">
        Cart
        <span>{{ cart.item_count }}</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        Menu
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <div class="page-width mobile-menu__inner">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
      <a href="{{ routes.search_url }}">Search</a>
      <a href="{{ routes.account_url }}">Account</a>
      <a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    }
  ]
}
{% endschema %}
