<section class="featured-products">
  <div class="page-width">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.link_label != blank and section.settings.link != blank %}
        <a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
      {% endif %}
    </div>

    {% assign display_collection = section.settings.collection | default: collections.all %}
    <div class="product-grid">
      {% if display_collection != blank %}
        {% for product in display_collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Popular right now"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular products with clear pricing and free shipping."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop the edit"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
