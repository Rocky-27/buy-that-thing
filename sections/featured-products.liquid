<section class="featured-products">
  <div class="page-width">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.link_label != blank and section.settings.link != blank %}
        <a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
      {% endif %}
    </div>

    {% assign display_collection = section.settings.collection | default: collections.all %}
    <div class="product-grid" data-randomized-listing data-visible-count="{{ section.settings.products_to_show }}">
      {% if display_collection != blank %}
        {% assign shown_products = 0 %}
        {% assign rendered_candidates = 0 %}
        {% assign candidate_limit = section.settings.products_to_show | plus: 8 %}
        {% assign available_candidate_total = display_collection.products.size %}
        {% assign candidate_window = available_candidate_total | minus: candidate_limit %}
        {% if candidate_window < 0 %}
          {% assign candidate_window = 0 %}
        {% endif %}
        {% assign random_seed = 'now' | date: '%s' | plus: section.id.size %}
        {% assign collection_offset = 0 %}
        {% if candidate_window > 0 %}
          {% assign collection_offset = random_seed | modulo: candidate_window %}
        {% endif %}
        {% for product in display_collection.products limit: candidate_limit offset: collection_offset %}
          {% if product.available %}
            <div data-randomized-item {% if shown_products >= section.settings.products_to_show %}hidden{% endif %}>
              {% render 'product-card', product: product %}
            </div>
            {% assign shown_products = shown_products | plus: 1 %}
            {% assign rendered_candidates = rendered_candidates | plus: 1 %}
            {% if rendered_candidates >= candidate_limit %}
              {% break %}
            {% endif %}
          {% endif %}
        {% endfor %}
        {% if rendered_candidates < candidate_limit %}
          {% for product in display_collection.products %}
            {% unless product.available %}
              <div data-randomized-item {% if shown_products >= section.settings.products_to_show %}hidden{% endif %}>
                {% render 'product-card', product: product %}
              </div>
              {% assign shown_products = shown_products | plus: 1 %}
              {% assign rendered_candidates = rendered_candidates | plus: 1 %}
              {% if rendered_candidates >= candidate_limit %}
                {% break %}
              {% endif %}
            {% endunless %}
          {% endfor %}
        {% endif %}
      {% endif %}
    </div>

    {% if display_collection != blank and display_collection.products.size > 0 %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "ItemList",
          "name": {{ section.settings.heading | json }},
          "itemListElement": [
            {% for product in display_collection.products limit: section.settings.products_to_show %}
              {
                "@type": "ListItem",
                "position": {{ forloop.index }},
                "url": {{ shop.url | append: product.url | json }},
                "item": {
                  "@type": "Product",
                  "name": {{ product.title | json }},
                  "url": {{ shop.url | append: product.url | json }}
                  {% if product.featured_media %}
                    , "image": {{ product.featured_media.preview_image | image_url: width: 900 | prepend: 'https:' | json }}
                  {% endif %}
                  , "offers": {
                    "@type": "Offer",
                    "priceCurrency": {{ shop.currency | json }},
                    "price": {{ product.price | divided_by: 100.0 | json }},
                    "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
                    "shippingDetails": {
                      "@type": "OfferShippingDetails",
                      "shippingDestination": {
                        "@type": "DefinedRegion",
                        "addressCountry": "GB"
                      },
                      "shippingRate": {
                        "@type": "MonetaryAmount",
                        "value": 0,
                        "currency": {{ shop.currency | json }}
                      }
                    }
                  }
                }
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        }
      </script>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Flying out"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular picks with prices you can feel good about."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "See more best-sellers"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
