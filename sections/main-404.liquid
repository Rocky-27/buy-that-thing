<section class="not-found-template">
  <div class="page-width">
    <div class="not-found-panel">
      <p class="section-eyebrow">Lost the plot?</p>
      <h1>That page has wandered off.</h1>
      <p class="not-found-copy">The link may be old, the product may have moved, or the internet has had a small wobble. Either way, there are better places to be.</p>

      <div class="not-found-actions">
        <a class="button button--primary" href="{{ routes.root_url }}">Back to homepage</a>
        <a class="button button--secondary" href="{{ routes.all_products_collection_url }}">Browse all products</a>
      </div>

      <div class="not-found-links">
        <a href="{{ routes.all_products_collection_url }}">Shop everything</a>
        <a href="{{ routes.search_url }}">Search the store</a>
        <a href="/pages/contact">Get in touch</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main 404"
}
{% endschema %}
