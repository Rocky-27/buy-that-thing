{% paginate collection.products by 250 %}
  <section class="collection-template">
    <div class="page-width">
      {% assign products_per_page = section.settings.products_per_page %}
      {% if collection.handle == 'all' %}
        {% assign products_per_page = 36 %}
      {% endif %}
      {% assign total_products = collection.products_count %}
      {% assign current_page_number = current_page | default: 1 %}
      {% assign page_offset = current_page_number | minus: 1 | times: products_per_page %}
      {% assign total_pages = total_products | times: 1.0 | divided_by: products_per_page | ceil %}
      {% assign has_filter_options = false %}
      {% for filter in collection.filters %}
        {% if filter.type == 'price_range' %}
          {% assign has_filter_options = true %}
          {% break %}
        {% endif %}
        {% for value in filter.values %}
          {% if value.count > 0 or value.active %}
            {% assign has_filter_options = true %}
            {% break %}
          {% endif %}
        {% endfor %}
        {% if has_filter_options %}
          {% break %}
        {% endif %}
      {% endfor %}
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span>/</span>
        <span>{{ collection.title }}</span>
      </nav>

      <div class="collection-title-row">
        <div>
          <h1>{{ collection.title }}</h1>
          <span>{{ collection.all_products_count }} finds</span>
        </div>
        {% if collection.description != blank %}
          <div class="rte collection-title-row__description">{{ collection.description }}</div>
        {% endif %}
      </div>

      <div class="collection-toolbar">
        {% if has_filter_options %}
          <button type="button" class="filter-drawer-toggle" data-filter-toggle>Filter and sort</button>
        {% else %}
          <div></div>
        {% endif %}
        <div class="active-filter-chips">
          {% for filter in collection.filters %}
            {% for active_value in filter.active_values %}
              <a href="{{ active_value.url_to_remove }}">{{ active_value.label }} ×</a>
            {% endfor %}
            {% if filter.type == 'price_range' %}
              {% if filter.min_value.value != nil or filter.max_value.value != nil %}
                <a href="{{ filter.url_to_remove }}">Price filter ×</a>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
        <form class="collection-toolbar__sort" method="get" data-sort-form>
          <label for="SortBy">Sort by</label>
          {% for filter in collection.filters %}
            {% for active_value in filter.active_values %}
              <input type="hidden" name="{{ active_value.param_name }}" value="{{ active_value.value }}">
            {% endfor %}
            {% if filter.type == 'price_range' %}
              {% if filter.min_value.value != nil %}
                <input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}">
              {% endif %}
              {% if filter.max_value.value != nil %}
                <input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}">
              {% endif %}
            {% endif %}
          {% endfor %}
          <select name="sort_by" id="SortBy" onchange="this.form.submit()">
            {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
            {% for option in collection.sort_options %}
              <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>
                {{ option.name }}
              </option>
            {% endfor %}
          </select>
        </form>
      </div>

      <div class="collection-layout{% unless has_filter_options %} collection-layout--simple{% endunless %}">
        {% if has_filter_options %}
          <aside class="collection-filters" data-filter-sidebar>
            <div class="collection-filters__header">
              <strong>Refine this collection</strong>
              <button type="button" data-filter-close>Close</button>
            </div>

            {% if collection.all_products_count > 0 %}
              <a class="filter-category-link" href="{{ collection.url }}">{{ collection.title }}</a>
            {% endif %}

            {% for filter in collection.filters %}
              {% assign visible_values = 0 %}
              {% if filter.type == 'price_range' %}
                <details class="filter-group" open>
                  <summary>{{ filter.label }}</summary>
                  <div class="filter-group__body">
                    <div class="price-filter">
                      <label>
                        Min
                        <input form="CollectionFilters" name="{{ filter.min_value.param_name }}" type="number" min="0" placeholder="0" {% if filter.min_value.value != nil %}value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %}>
                      </label>
                      <label>
                        Max
                        <input form="CollectionFilters" name="{{ filter.max_value.param_name }}" type="number" min="0" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}" {% if filter.max_value.value != nil %}value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"{% endif %}>
                      </label>
                    </div>
                  </div>
                </details>
              {% else %}
                {% for value in filter.values %}
                  {% if value.count > 0 or value.active %}
                    {% assign visible_values = visible_values | plus: 1 %}
                  {% endif %}
                {% endfor %}
                {% if visible_values > 0 %}
                  <details class="filter-group" open>
                    <summary>{{ filter.label }}</summary>
                    <div class="filter-group__body">
                      {% for value in filter.values limit: 12 %}
                        {% if value.count > 0 or value.active %}
                          <label class="filter-checkbox{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {% if value.active %}checked{% endif %}
                              {% if value.count == 0 and value.active == false %}disabled{% endif %}
                              form="CollectionFilters"
                            >
                            <span>{{ value.label }}</span>
                            <em>{{ value.count }}</em>
                          </label>
                        {% endif %}
                      {% endfor %}
                    </div>
                  </details>
                {% endif %}
              {% endif %}
            {% endfor %}

            <form id="CollectionFilters" class="filter-actions" method="get">
              {% if sort_by != blank %}
                <input type="hidden" name="sort_by" value="{{ sort_by }}">
              {% endif %}
              <button class="button button--primary" type="submit">Apply filters</button>
              <a href="{{ collection.url }}">Clear all</a>
            </form>
          </aside>
        {% endif %}

        <div class="collection-products">
          <div class="collection-products__meta">
            <span>{{ total_products }} products shown</span>
            <span>Free delivery included on every order</span>
          </div>
          <div class="product-grid product-grid--listing">
            {% assign rendered_product = false %}
            {% assign ordered_index = 0 %}
            {% assign shown_in_page = 0 %}
            {% for product in collection.products %}
              {% if product.available %}
                {% if ordered_index >= page_offset and shown_in_page < products_per_page %}
                  {% render 'product-card', product: product %}
                  {% assign rendered_product = true %}
                  {% assign shown_in_page = shown_in_page | plus: 1 %}
                {% endif %}
                {% assign ordered_index = ordered_index | plus: 1 %}
              {% endif %}
            {% endfor %}
            {% for product in collection.products %}
              {% unless product.available %}
                {% if ordered_index >= page_offset and shown_in_page < products_per_page %}
                  {% render 'product-card', product: product %}
                  {% assign rendered_product = true %}
                  {% assign shown_in_page = shown_in_page | plus: 1 %}
                {% endif %}
                {% assign ordered_index = ordered_index | plus: 1 %}
              {% endunless %}
            {% endfor %}
            {% unless rendered_product %}
              <p class="collection-empty-state">Nothing matched those filters. Clear a few and the good stuff should reappear.</p>
            {% endunless %}
          </div>
        </div>
      </div>

      {% capture pagination_query %}
        {% if sort_by != blank and sort_by != collection.default_sort_by %}sort_by={{ sort_by | url_encode }}&{% endif %}
        {% for filter in collection.filters %}
          {% for active_value in filter.active_values %}{{ active_value.param_name | url_encode }}={{ active_value.value | url_encode }}&{% endfor %}
          {% if filter.type == 'price_range' %}
            {% if filter.min_value.value != nil %}{{ filter.min_value.param_name | url_encode }}={{ filter.min_value.value | money_without_currency | replace: ',', '' | url_encode }}&{% endif %}
            {% if filter.max_value.value != nil %}{{ filter.max_value.param_name | url_encode }}={{ filter.max_value.value | money_without_currency | replace: ',', '' | url_encode }}&{% endif %}
          {% endif %}
        {% endfor %}
      {% endcapture %}
      {% assign pagination_query = pagination_query | strip | strip_newlines %}
      {% if total_pages > 1 %}
        <nav class="pagination" aria-label="Pagination">
          {% if current_page_number > 1 %}
            <a href="{{ collection.url }}?page={{ current_page_number | minus: 1 }}{% if pagination_query != blank %}&{{ pagination_query }}{% endif %}">Previous</a>
          {% endif %}
          <span>Page {{ current_page_number }} of {{ total_pages }}</span>
          {% if current_page_number < total_pages %}
            <a href="{{ collection.url }}?page={{ current_page_number | plus: 1 }}{% if pagination_query != blank %}&{{ pagination_query }}{% endif %}">Next</a>
          {% endif %}
        </nav>
      {% endif %}
    </div>
  </section>
{% endpaginate %}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": {{ collection.title | json }},
    "url": {{ shop.url | append: collection.url | json }},
    "itemListElement": [
      {% for product in collection.products limit: 24 %}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "url": {{ shop.url | append: product.url | json }},
          "item": {
            "@type": "Product",
            "name": {{ product.title | json }},
            "url": {{ shop.url | append: product.url | json }}
            {% if product.featured_media %}
              , "image": {{ product.featured_media.preview_image | image_url: width: 900 | prepend: 'https:' | json }}
            {% endif %}
            {% if product.price %}
              , "offers": {
                "@type": "Offer",
                "priceCurrency": {{ shop.currency | json }},
                "price": {{ product.price | divided_by: 100.0 | json }},
                "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
                "shippingDetails": {
                  "@type": "OfferShippingDetails",
                  "shippingDestination": {
                    "@type": "DefinedRegion",
                    "addressCountry": "GB"
                  },
                  "shippingRate": {
                    "@type": "MonetaryAmount",
                    "value": 0,
                    "currency": {{ shop.currency | json }}
                  }
                }
              }
            {% endif %}
          }
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
</script>

{% schema %}
{
  "name": "Main collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 12,
      "max": 36,
      "step": 4,
      "label": "Products per page",
      "default": 24
    }
  ]
}
{% endschema %}
