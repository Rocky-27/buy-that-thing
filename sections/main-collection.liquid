{% liquid
  assign default_page_size = section.settings.products_per_page
  case default_page_size
    when '18'
      assign products_per_page = 18
    when '30'
      assign products_per_page = 30
    when '36'
      assign products_per_page = 36
    else
      assign products_per_page = 24
  endcase
  capture header_markup
    echo content_for_header
  endcapture
  assign page_url = header_markup | split: '"pageurl":"' | last | split: '"' | first | replace: '\/', '/' | replace: '%20', ' ' | replace: '\u0026', '&'
  if page_url contains '?'
    assign query_string = page_url | split: '?' | last
    assign query_params = query_string | split: '&'
    for pair in query_params
      assign param_parts = pair | split: '='
      assign param_key = param_parts | first
      assign param_value = param_parts | last
      if param_key == 'count'
        case param_value
          when '18'
            assign products_per_page = 18
          when '24'
            assign products_per_page = 24
          when '30'
            assign products_per_page = 30
          when '36'
            assign products_per_page = 36
        endcase
      endif
    endfor
  endif
%}

{% paginate collection.products by products_per_page %}
  <section class="collection-template">
    <div class="page-width">
      {% assign parent_collection = collection.metafields.custom.parent_collection.value %}
      {% assign child_collections = collection.metafields.custom.child_collections.value %}
      {% assign ancestor_1 = parent_collection %}
      {% assign ancestor_2 = blank %}
      {% assign ancestor_3 = blank %}
      {% assign ancestor_4 = blank %}
      {% assign ancestor_5 = blank %}
      {% assign ancestor_6 = blank %}
      {% if ancestor_1 != blank %}
        {% assign ancestor_2 = ancestor_1.metafields.custom.parent_collection.value %}
      {% endif %}
      {% if ancestor_2 != blank %}
        {% assign ancestor_3 = ancestor_2.metafields.custom.parent_collection.value %}
      {% endif %}
      {% if ancestor_3 != blank %}
        {% assign ancestor_4 = ancestor_3.metafields.custom.parent_collection.value %}
      {% endif %}
      {% if ancestor_4 != blank %}
        {% assign ancestor_5 = ancestor_4.metafields.custom.parent_collection.value %}
      {% endif %}
      {% if ancestor_5 != blank %}
        {% assign ancestor_6 = ancestor_5.metafields.custom.parent_collection.value %}
      {% endif %}
      {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
      {% assign has_sidebar_content = false %}
      {% if child_collections != blank %}
        {% assign has_sidebar_content = true %}
      {% endif %}
      {% assign viewing_from = paginate.current_offset | plus: 1 %}
      {% assign viewing_to = paginate.current_offset | plus: collection.products.size %}
      {% capture count_query_suffix %}{% if products_per_page != blank %}{% if products_per_page == 24 %}count=24{% elsif products_per_page == 18 %}count=18{% elsif products_per_page == 30 %}count=30{% elsif products_per_page == 36 %}count=36{% endif %}{% endif %}{% endcapture %}
      {% assign count_query_suffix = count_query_suffix | strip %}
      {% if paginate.items == 0 %}
        {% assign viewing_from = 0 %}
        {% assign viewing_to = 0 %}
      {% endif %}

      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span>/</span>
        {% if ancestor_6 != blank %}
          <a href="{{ ancestor_6.url }}">{{ ancestor_6.title }}</a>
          <span>/</span>
        {% endif %}
        {% if ancestor_5 != blank %}
          <a href="{{ ancestor_5.url }}">{{ ancestor_5.title }}</a>
          <span>/</span>
        {% endif %}
        {% if ancestor_4 != blank %}
          <a href="{{ ancestor_4.url }}">{{ ancestor_4.title }}</a>
          <span>/</span>
        {% endif %}
        {% if ancestor_3 != blank %}
          <a href="{{ ancestor_3.url }}">{{ ancestor_3.title }}</a>
          <span>/</span>
        {% endif %}
        {% if ancestor_2 != blank %}
          <a href="{{ ancestor_2.url }}">{{ ancestor_2.title }}</a>
          <span>/</span>
        {% endif %}
        {% if ancestor_1 != blank %}
          <a href="{{ ancestor_1.url }}">{{ ancestor_1.title }}</a>
          <span>/</span>
        {% endif %}
        <span>{{ collection.title }}</span>
      </nav>

      <div class="collection-title-row">
        <div>
          {% if parent_collection != blank %}
            <a class="collection-parent-link" href="{{ parent_collection.url }}">Back to {{ parent_collection.title }}</a>
          {% endif %}
          <h1>{{ collection.title }}</h1>
          <span>{{ paginate.items }} finds</span>
        </div>
        {% if collection.description != blank %}
          <div class="rte collection-title-row__description">{{ collection.description }}</div>
        {% endif %}
      </div>

      <div class="collection-toolbar">
        <div class="collection-toolbar__primary">
          {% if has_sidebar_content %}
            <button
              type="button"
              class="filter-drawer-toggle"
              data-filter-toggle
              aria-expanded="false"
              aria-controls="CollectionFiltersMobile"
            >
              Browse categories
            </button>
            <div class="collection-mobile-categories" id="CollectionFiltersMobile" data-filter-sidebar-mobile hidden>
              <div class="collection-filters__header">
                <strong>Browse categories</strong>
                <button type="button" data-filter-close-mobile>Close</button>
              </div>
              {% if child_collections != blank %}
                <div class="filter-browse">
                  <div class="filter-browse__heading">
                    <strong>Browse this department</strong>
                    <span>Jump straight into the most relevant subcategory.</span>
                  </div>
                  <div class="filter-browse__links">
                    {% for child_collection in child_collections %}
                      <a class="filter-browse__link" href="{{ child_collection.url }}">
                        <span>{{ child_collection.title }}</span>
                        <em>{{ child_collection.products_count }} finds</em>
                      </a>
                    {% endfor %}
                  </div>
                </div>
              {% endif %}
            </div>
          {% endif %}
          <form class="collection-toolbar__sort" method="get" data-sort-form>
            <label for="SortBy">Sort by</label>
            <select name="sort_by" id="SortBy" onchange="this.form.submit()">
              {% for option in collection.sort_options %}
                <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>
                  {{ option.name }}
                </option>
              {% endfor %}
            </select>
            <label for="ProductsPerPage">Show</label>
            <select name="count" id="ProductsPerPage" onchange="this.form.submit()">
              <option value="18" {% if products_per_page == 18 %}selected{% endif %}>18</option>
              <option value="24" {% if products_per_page == 24 %}selected{% endif %}>24</option>
              <option value="30" {% if products_per_page == 30 %}selected{% endif %}>30</option>
              <option value="36" {% if products_per_page == 36 %}selected{% endif %}>36</option>
            </select>
          </form>
        </div>
        <div class="collection-toolbar__status">
          <div class="collection-toolbar__summary">
            <strong>Viewing {{ viewing_from }}-{{ viewing_to }}</strong>
            <span>of {{ paginate.items }} products</span>
            <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          </div>
          <span class="collection-toolbar__note">Free delivery included on every order</span>
        </div>
      </div>

      <div class="collection-layout{% unless has_sidebar_content %} collection-layout--simple{% endunless %}">
        {% if has_sidebar_content %}
          <aside class="collection-filters" id="CollectionFilters" data-filter-sidebar>
            <div class="collection-filters__header">
              <strong>Browse categories</strong>
              <button type="button" data-filter-close>Close</button>
            </div>

            {% if child_collections != blank %}
              <div class="filter-browse">
                <div class="filter-browse__heading">
                  <strong>Browse this department</strong>
                  <span>Jump straight into the most relevant subcategory.</span>
                </div>
                <div class="filter-browse__links">
                  {% for child_collection in child_collections %}
                    <a class="filter-browse__link" href="{{ child_collection.url }}">
                      <span>{{ child_collection.title }}</span>
                      <em>{{ child_collection.products_count }} finds</em>
                    </a>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
          </aside>
        {% endif %}

        <div class="collection-products">
          {% if paginate.pages > 1 %}
            <nav class="pagination pagination--top" aria-label="Pagination">
              {% if paginate.previous %}
                <a href="{{ paginate.previous.url }}{% if count_query_suffix != blank %}{% if paginate.previous.url contains '?' %}&{{ count_query_suffix }}{% else %}?{{ count_query_suffix }}{% endif %}{% endif %}">Previous</a>
              {% endif %}
              {% for part in paginate.parts %}
                {% if part.is_link %}
                  <a href="{{ part.url }}{% if count_query_suffix != blank %}{% if part.url contains '?' %}&{{ count_query_suffix }}{% else %}?{{ count_query_suffix }}{% endif %}{% endif %}">{{ part.title }}</a>
                {% else %}
                  <span{% if part.title == paginate.current_page %} aria-current="page"{% endif %}>{{ part.title }}</span>
                {% endif %}
              {% endfor %}
              {% if paginate.next %}
                <a href="{{ paginate.next.url }}{% if count_query_suffix != blank %}{% if paginate.next.url contains '?' %}&{{ count_query_suffix }}{% else %}?{{ count_query_suffix }}{% endif %}{% endif %}">Next</a>
              {% endif %}
            </nav>
          {% endif %}
          <div class="product-grid product-grid--listing">
            {% if collection.products.size > 0 %}
              {% for product in collection.products %}
                {% render 'product-card', product: product %}
              {% endfor %}
            {% else %}
              <p class="collection-empty-state">Nothing matched those filters. Clear a few and the good stuff should reappear.</p>
            {% endif %}
          </div>
        </div>
      </div>

      {% if paginate.pages > 1 %}
        <nav class="pagination" aria-label="Pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}{% if count_query_suffix != blank %}{% if paginate.previous.url contains '?' %}&{{ count_query_suffix }}{% else %}?{{ count_query_suffix }}{% endif %}{% endif %}">Previous</a>
          {% endif %}
          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}{% if count_query_suffix != blank %}{% if part.url contains '?' %}&{{ count_query_suffix }}{% else %}?{{ count_query_suffix }}{% endif %}{% endif %}">{{ part.title }}</a>
            {% else %}
              <span{% if part.title == paginate.current_page %} aria-current="page"{% endif %}>{{ part.title }}</span>
            {% endif %}
          {% endfor %}
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}{% if count_query_suffix != blank %}{% if paginate.next.url contains '?' %}&{{ count_query_suffix }}{% else %}?{{ count_query_suffix }}{% endif %}{% endif %}">Next</a>
          {% endif %}
        </nav>
      {% endif %}
    </div>
  </section>
{% endpaginate %}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": {{ collection.title | json }},
    "url": {{ shop.url | append: collection.url | json }},
    "itemListElement": [
      {% for product in collection.products limit: 24 %}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "url": {{ shop.url | append: product.url | json }},
          "item": {
            "@type": "Product",
            "name": {{ product.title | json }},
            "url": {{ shop.url | append: product.url | json }}
            {% if product.featured_media %}
              , "image": {{ product.featured_media.preview_image | image_url: width: 900 | prepend: 'https:' | json }}
            {% endif %}
            {% if product.price %}
              , "offers": {
                "@type": "Offer",
                "priceCurrency": {{ shop.currency | json }},
                "price": {{ product.price | divided_by: 100.0 | json }},
                "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
                "shippingDetails": {
                  "@type": "OfferShippingDetails",
                  "shippingDestination": {
                    "@type": "DefinedRegion",
                    "addressCountry": "GB"
                  },
                  "shippingRate": {
                    "@type": "MonetaryAmount",
                    "value": 0,
                    "currency": {{ shop.currency | json }}
                  }
                }
              }
            {% endif %}
          }
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
</script>

{% schema %}
{
  "name": "Main collection",
  "settings": [
    {
      "type": "select",
      "id": "products_per_page",
      "label": "Default products per page",
      "default": "24",
      "options": [
        {
          "value": "18",
          "label": "18"
        },
        {
          "value": "24",
          "label": "24"
        },
        {
          "value": "30",
          "label": "30"
        },
        {
          "value": "36",
          "label": "36"
        }
      ]
    }
  ]
}
{% endschema %}
