<section class="promo-mosaic">
  <div class="page-width promo-mosaic__grid">
    {% for block in section.blocks %}
      <article class="promo-tile promo-tile--{{ forloop.index }}" {{ block.shopify_attributes }}>
        <div class="promo-tile__content">
          <p class="section-eyebrow">{{ block.settings.eyebrow }}</p>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
          {% if block.settings.link_label != blank and block.settings.link != blank %}
            <a class="button button--dark" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
          {% endif %}
        </div>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'promo-tile__image', loading: 'lazy' }}
        {% endif %}
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Promo mosaic",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Start here"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "A mix of practical upgrades, personality pieces and finds you would not usually stumble across in one go."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "From home fixes to garden bits to odd little gift ideas, this is the broadest view of what the shop is trying to do well."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "See the edit"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo mosaic",
      "blocks": [
        { "type": "tile", "settings": { "eyebrow": "Start here", "heading": "A mix of practical upgrades, personality pieces and finds you would not usually stumble across in one go.", "text": "From home fixes to garden bits to odd little gift ideas, this is the broadest view of what the shop is trying to do well." } },
        { "type": "tile", "settings": { "eyebrow": "Worth a peek", "heading": "The sort of catalogue you can properly rummage through without wading through pages of filler.", "text": "We are not trying to be everything. We are trying to surface the useful, the fun and the slightly unexpected.", "link_label": "See the good ones" } },
        { "type": "tile", "settings": { "eyebrow": "Finish the room, sort the corner, find the extra bit", "heading": "Often it is the smaller add-ons and supporting pieces that make the main buy feel right.", "text": "That might mean the storage that tidies it up, the accessory that completes it, or the extra detail that gives it more life.", "link_label": "Complete the setup" } }
      ]
    }
  ]
}
{% endschema %}
