<section class="promo-mosaic">
  <div class="page-width promo-mosaic__grid">
    {% for block in section.blocks %}
      <article class="promo-tile promo-tile--{{ forloop.index }}" {{ block.shopify_attributes }}>
        <div class="promo-tile__content">
          <p class="section-eyebrow">{{ block.settings.eyebrow }}</p>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
          {% if block.settings.link_label != blank and block.settings.link != blank %}
            <a class="button button--dark" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
          {% endif %}
        </div>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'promo-tile__image', loading: 'lazy' }}
        {% endif %}
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Promo mosaic",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Start here"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The useful stuff people end up telling friends about."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Browse clever buys that make a room nicer, a job easier or a routine less annoying."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "See the edit"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo mosaic",
      "blocks": [
        { "type": "tile", "settings": { "eyebrow": "Start here", "heading": "The useful stuff people end up telling friends about.", "text": "Browse clever buys that make a room nicer, a job easier or a routine less annoying." } },
        { "type": "tile", "settings": { "eyebrow": "Worth a peek", "heading": "Good prices on things you will actually use.", "text": "Skip the filler and head straight for the practical wins with surprisingly decent price tags.", "link_label": "See the good ones" } },
        { "type": "tile", "settings": { "eyebrow": "Finish the job", "heading": "The extras that make the main buy feel properly sorted.", "text": "Find the add-ons, accessories and finishing touches that stop a good idea being half-done.", "link_label": "Complete the setup" } }
      ]
    }
  ]
}
{% endschema %}
