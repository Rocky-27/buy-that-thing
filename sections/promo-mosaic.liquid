<section class="promo-mosaic">
  <div class="page-width promo-mosaic__grid">
    {% for block in section.blocks %}
      <article class="promo-tile promo-tile--{{ forloop.index }}" {{ block.shopify_attributes }}>
        <div class="promo-tile__content">
          <p class="section-eyebrow">{{ block.settings.eyebrow }}</p>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
          {% if block.settings.link_label != blank and block.settings.link != blank %}
            <a class="button button--dark" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
          {% endif %}
        </div>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'promo-tile__image', loading: 'lazy' }}
        {% endif %}
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Promo mosaic",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Worth a look"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop smart categories and blink-and-miss-it offers."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Dip into practical finds, giftable upgrades and price tags that pull their weight."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "See the edit"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo mosaic",
      "blocks": [
        { "type": "tile", "settings": { "eyebrow": "Fresh picks", "heading": "Small upgrades, oddly satisfying payoff.", "text": "Explore home and everyday finds that solve a problem, lift a room or make life easier." } },
        { "type": "tile", "settings": { "eyebrow": "Bundle ideas", "heading": "Build the full setup.", "text": "Pair the headline buy with the extras that make it work even harder.", "link_label": "Shop the combo" } },
        { "type": "tile", "settings": { "eyebrow": "Category spotlight", "heading": "Start with the category doing the most.", "text": "Browse the ranges packed with the biggest mix of value and crowd-pleasers.", "link_label": "Explore the range" } }
      ]
    }
  ]
}
{% endschema %}
