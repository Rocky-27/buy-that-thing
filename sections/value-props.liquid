<section class="value-props">
  <div class="page-width value-props__grid">
    {% for block in section.blocks %}
      <article class="value-prop-card" {{ block.shopify_attributes }}>
        <span class="value-prop-card__icon">{{ block.settings.icon }}</span>
        <div>
          <p class="value-prop-card__eyebrow">{{ block.settings.eyebrow }}</p>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Value props",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Value prop",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Included on every order"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "No minimum spend required."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value props",
      "blocks": [
        { "type": "item" },
        { "type": "item", "settings": { "icon": "£", "eyebrow": "Current offers", "heading": "New savings added regularly", "text": "Shop value buys across popular categories." } },
        { "type": "item", "settings": { "icon": "↺", "eyebrow": "Returns", "heading": "Simple returns", "text": "Clear support if something is not right." } }
      ]
    }
  ]
}
{% endschema %}
