<section class="newsletter-band">
  <div class="page-width newsletter-band__inner">
    <div>
      <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {% if form.posted_successfully? %}
        <p class="form-success">You are in. Expect first dibs on fresh deals and restocks.</p>
      {% else %}
        <input type="email" name="contact[email]" placeholder="Your best email" required>
        <button type="submit" class="button button--primary">Count me in</button>
      {% endif %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter band",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Inbox perks"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get the good finds before everyone else."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Sign up for deal drops, restock alerts and useful or gloriously unnecessary finds worth seeing first."
    }
  ],
  "presets": [
    {
      "name": "Newsletter band"
    }
  ]
}
{% endschema %}
