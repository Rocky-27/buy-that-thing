<section class="list-collections-template">
  <div class="page-width">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">Shop every corner</p>
        <h1>Browse by category and go straight to the good stuff.</h1>
      </div>
    </div>

    <div class="collection-grid">
      {% for collection in collections %}
        {% if collection.products_count > 0 %}
          {% render 'collection-card', collection: collection %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main list collections"
}
{% endschema %}
