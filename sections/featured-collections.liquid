<section class="featured-collections">
  <div class="page-width">
    <div class="section-heading">
      <div>
        <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.link_label != blank and section.settings.link != blank %}
        <a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
      {% endif %}
    </div>

    <div class="collection-grid">
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}
        {% render 'collection-card', collection: collection, custom_title: block.settings.title, custom_text: block.settings.text %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collections",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by demand pattern"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections that keep a large catalog easy to shop."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all collections"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Custom text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
