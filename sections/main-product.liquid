{% assign current_variant = product.selected_or_first_available_variant %}
{% assign rating = product.metafields.reviews.rating.value %}
{% assign rating_count = product.metafields.reviews.rating_count.value %}
{% assign savings = current_variant.compare_at_price | minus: current_variant.price %}
{% assign vendor_normalized = product.vendor | downcase | strip | replace: '-', '' | replace: '_', '' | replace: '.', '' | replace: ' ', '' %}
{% assign breadcrumb_collection = blank %}
{% if collection and collection.handle == 'special-offer' %}
  {% assign breadcrumb_collection = collection %}
{% elsif collection %}
  {% assign breadcrumb_collection = collection %}
{% else %}
  {% for product_collection in product.collections %}
    {% if product_collection.handle != 'special-offer' %}
      {% assign breadcrumb_collection = product_collection %}
      {% break %}
    {% endif %}
  {% endfor %}
  {% if breadcrumb_collection == blank %}
    {% assign breadcrumb_collection = product.collections.first %}
  {% endif %}
{% endif %}
{% assign hide_vendor = false %}
{% if vendor_normalized == blank or vendor_normalized == 'unbranded' or vendor_normalized == 'na' or vendor_normalized == 'none' or vendor_normalized == 'unknown' or vendor_normalized == 'generic' or vendor_normalized == 'novendor' %}
  {% assign hide_vendor = true %}
{% endif %}
<section class="product-template" data-product-root data-money-format="{{ shop.money_format | escape }}" data-product-handle="{{ product.handle }}">
  <div class="page-width">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>/</span>
      {% if breadcrumb_collection %}
        <a href="{{ breadcrumb_collection.url }}">{{ breadcrumb_collection.title }}</a>
        <span>/</span>
      {% endif %}
      <span>{{ product.title }}</span>
    </nav>

    <div class="product-return-links">
      <a class="product-return-link" href="#" data-return-to-search hidden>Return to search</a>
    </div>

    <div class="product-template__grid">
      <div class="product-gallery">
        <div class="product-gallery__main" data-product-zoom-surface>
          {% if current_variant.featured_media %}
            <img
              class="product-gallery__image"
              src="{{ current_variant.featured_media.preview_image | image_url: width: 1400 }}"
              alt="{{ current_variant.featured_media.alt | escape }}"
              loading="eager"
              data-zoom-image="{% if current_variant.featured_media.preview_image %}{{ current_variant.featured_media.preview_image | image_url: width: 2200 }}{% endif %}"
              data-product-image
            >
          {% elsif product.featured_media %}
            <img
              class="product-gallery__image"
              src="{{ product.featured_media.preview_image | image_url: width: 1400 }}"
              alt="{{ product.featured_media.alt | escape }}"
              loading="eager"
              data-zoom-image="{% if product.featured_media.preview_image %}{{ product.featured_media.preview_image | image_url: width: 2200 }}{% endif %}"
              data-product-image
            >
          {% endif %}
          <div class="product-gallery__magnifier" data-product-magnifier aria-hidden="true"></div>
          <button class="product-gallery__zoom" type="button" data-product-zoom-open>Enlarge</button>
        </div>

        {% if product.media.size > 1 %}
          <div class="product-gallery__thumbs">
            {% for media in product.media %}
              <button
                class="product-thumb{% if forloop.first %} is-active{% endif %}"
                type="button"
                data-product-thumb
                data-image="{{ media.preview_image | image_url: width: 1400 }}"
                data-zoom-image="{{ media.preview_image | image_url: width: 2200 }}"
                data-image-alt="{{ media.alt | default: product.title | escape }}"
              >
                {{ media.preview_image | image_url: width: 320 | image_tag: loading: 'lazy' }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="product-summary">
        {% unless hide_vendor %}
          <p class="section-eyebrow">{{ product.vendor }}</p>
        {% endunless %}
        <h1>{{ product.title }}</h1>
        {% if rating != blank or hide_vendor == false %}
          <div class="product-rating-row">
            {% if rating != blank %}
              <span class="rating-stars">{{ rating.rating | round: 1 }} / 5</span>
              {% if rating_count != blank %}
                <span>{{ rating_count }} reviews</span>
              {% endif %}
            {% endif %}
            {% unless hide_vendor %}
              <span class="verified-pill">Sold by {{ product.vendor }}</span>
            {% endunless %}
          </div>
        {% endif %}
        <div class="product-summary__price" data-product-price>
          {% render 'price', product: product, use_variant: true %}
        </div>
        <p class="sale-callout{% unless current_variant.compare_at_price > current_variant.price %} is-hidden{% endunless %}" data-product-sale-callout>
          {% if current_variant.compare_at_price > current_variant.price %}Nice choice: save {{ savings | money }} on this option.{% endif %}
        </p>
        <div class="product-status-row">
          <span class="product-status-pill{% unless current_variant.available %} product-status-pill--muted{% endunless %}" data-product-status-pill>
            {% if current_variant.available %}Ready to order{% else %}Currently unavailable{% endif %}
          </span>
          <span>Free delivery included</span>
        </div>
        {% if product.description != blank %}
          <div class="product-summary__description-wrap" data-product-description-summary-wrap>
            <div class="rte product-summary__description" data-product-description-summary></div>
            <button class="text-link product-summary__description-toggle is-hidden" type="button" data-product-description-toggle aria-expanded="false">
              Read more
            </button>
            <div class="product-summary__description-source" data-product-description-source hidden>{{ product.description }}</div>
          </div>
        {% endif %}

        {% form 'product', product, class: 'product-form' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              {% assign option_index = option.position | minus: 1 %}
              <fieldset class="product-option">
                <legend>{{ option.name }}</legend>
                <div class="product-option__values">
                  {% for value in option.values %}
                    {% assign value_available = false %}
                    {% for variant in product.variants %}
                      {% if variant.available and variant.options[option_index] == value %}
                        {% assign value_available = true %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                    <label{% unless value_available %} class="is-disabled"{% endunless %}>
                      <input
                        type="radio"
                        name="options[{{ option.name | escape }}]"
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}
                        {% unless value_available %}disabled{% endunless %}
                        data-option-input
                      >
                      <span>{{ value }}</span>
                    </label>
                  {% endfor %}
                </div>
              </fieldset>
            {% endfor %}
          {% endunless %}

          <div class="product-form__row">
            <label class="quantity-field" for="Quantity-{{ section.id }}">
              <span>Quantity</span>
              <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1">
            </label>
            <button class="button button--primary button--block" type="submit" {% unless current_variant.available %}disabled{% endunless %} data-add-to-cart>
              {% if current_variant.available %}Add to basket{% else %}Sold out{% endif %}
            </button>
          </div>
        {% endform %}

        <div class="delivery-panel">
          <strong>Why this is an easy yes</strong>
          <div>
            <span class="delivery-badge">Free delivery</span>
            <span>Included on every order, with no minimum spend to unlock it.</span>
          </div>
          <div>
            <span class="delivery-badge delivery-badge--soft">Secure checkout</span>
            <span>Pay by card or accelerated checkout with a smooth, familiar flow.</span>
          </div>
        </div>

        <div class="product-trust">
          <div>
            <strong>Order updates</strong>
            <span>We keep you posted from order confirmation through delivery.</span>
          </div>
          <div>
            <strong>Support that makes sense</strong>
            <span>If something needs attention, the next step is clear and easy to find.</span>
          </div>
        </div>
      </div>
    </div>

    <div class="product-detail-tabs" id="product-details">
      <details open>
        <summary>Product details</summary>
        <div class="rte product-description-richtext" data-product-description-richtext>{{ product.description }}</div>
      </details>
      <details>
        <summary>Delivery and returns</summary>
        <p>Free delivery is included on every order. Final delivery timing and any supplier-specific return details are confirmed during checkout so you know exactly what to expect.</p>
      </details>
    </div>

    {% assign similar_collection = breadcrumb_collection | default: product.collections.first %}
    {% assign similar_products_rendered = 0 %}
    {% if similar_collection != blank and similar_collection.products_count > 1 %}
      <section class="product-similar">
        <div class="section-heading">
          <div>
            <p class="section-eyebrow">Similar to this item</p>
            <h2>More finds in the same vein</h2>
          </div>
          <a class="text-link" href="{{ similar_collection.url }}">Shop {{ similar_collection.title }}</a>
        </div>
        <div class="product-grid">
          {% for related_product in similar_collection.products %}
            {% if related_product.handle != product.handle %}
              {% render 'product-card', product: related_product %}
              {% assign similar_products_rendered = similar_products_rendered | plus: 1 %}
            {% endif %}
            {% if similar_products_rendered >= 4 %}
              {% break %}
            {% endif %}
          {% endfor %}
        </div>
      </section>
    {% endif %}
  </div>

  <div class="product-zoom-modal" data-product-zoom hidden>
    <button class="product-zoom-modal__close" type="button" aria-label="Close enlarged image" data-product-zoom-close>×</button>
    <div class="product-zoom-modal__backdrop" data-product-zoom-close></div>
    <div class="product-zoom-modal__dialog" role="dialog" aria-modal="true" aria-label="Enlarged product image">
      <img class="product-zoom-modal__image" src="" alt="" data-product-zoom-image>
    </div>
  </div>

  <script type="application/json" data-product-json>
    {{ product.variants | json }}
  </script>

  <script type="application/json" data-product-card-json>
    {
      "handle": {{ product.handle | json }},
      "title": {{ product.title | json }},
      "url": {{ product.url | json }},
      "vendor": {% if hide_vendor %}""{% else %}{{ product.vendor | json }}{% endif %},
      "image": {% if product.featured_media %}{{ product.featured_media.preview_image | image_url: width: 900 | json }}{% else %}""{% endif %},
      "price": {{ current_variant.price | json }},
      "compareAtPrice": {{ current_variant.compare_at_price | default: 0 | json }},
      "available": {{ current_variant.available | json }}
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": {{ shop.url | append: product.url | append: '#product' | json }},
      "name": {{ product.title | json }},
      "url": {{ shop.url | append: product.url | json }},
      {% if product.featured_media %}
        "image": {{ product.featured_media.preview_image | image_url: width: 1200 | prepend: 'https:' | json }},
      {% endif %}
      {% if product.description != blank %}
        "description": {{ product.description | strip_html | strip_newlines | json }},
      {% endif %}
      {% unless hide_vendor %}
        "brand": {
          "@type": "Brand",
          "name": {{ product.vendor | json }}
        },
      {% endunless %}
      "offers": [
        {% for variant in product.variants %}
          {
            "@type": "Offer",
            "url": {{ shop.url | append: product.url | append: '?variant=' | append: variant.id | json }},
            "priceCurrency": {{ shop.currency | json }},
            "price": {{ variant.price | divided_by: 100.0 | json }},
            {% if variant.sku != blank %}
              "sku": {{ variant.sku | json }},
            {% endif %}
            "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "itemCondition": "https://schema.org/NewCondition",
            "shippingDetails": {
              "@type": "OfferShippingDetails",
              "shippingDestination": {
                "@type": "DefinedRegion",
                "addressCountry": "GB"
              },
              "shippingRate": {
                "@type": "MonetaryAmount",
                "value": 0,
                "currency": {{ shop.currency | json }}
              }
            }
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "Main product"
}
{% endschema %}
