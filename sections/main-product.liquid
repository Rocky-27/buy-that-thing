{% assign current_variant = product.selected_or_first_available_variant %}
{% assign rating = product.metafields.reviews.rating.value %}
{% assign rating_count = product.metafields.reviews.rating_count.value %}
<section class="product-template" data-product-root data-money-format="{{ shop.money_format | escape }}">
  <div class="page-width">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span>/</span>
      {% if product.collections.first %}
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
        <span>/</span>
      {% endif %}
      <span>{{ product.title }}</span>
    </nav>

    <div class="product-template__grid">
      <div class="product-gallery">
        <div class="product-gallery__main">
          {% if current_variant.featured_media %}
            <img
              class="product-gallery__image"
              src="{{ current_variant.featured_media.preview_image | image_url: width: 1400 }}"
              alt="{{ current_variant.featured_media.alt | escape }}"
              loading="eager"
              data-product-image
            >
          {% elsif product.featured_media %}
            <img
              class="product-gallery__image"
              src="{{ product.featured_media.preview_image | image_url: width: 1400 }}"
              alt="{{ product.featured_media.alt | escape }}"
              loading="eager"
              data-product-image
            >
          {% endif %}
        </div>

        {% if product.media.size > 1 %}
          <div class="product-gallery__thumbs">
            {% for media in product.media %}
              <button class="product-thumb{% if forloop.first %} is-active{% endif %}" type="button" data-product-thumb data-image="{{ media.preview_image | image_url: width: 1400 }}">
                {{ media.preview_image | image_url: width: 320 | image_tag: loading: 'lazy' }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="product-summary">
        {% if product.vendor != blank %}
          <p class="section-eyebrow">{{ product.vendor }}</p>
        {% endif %}
        <h1>{{ product.title }}</h1>
        {% if rating != blank or product.vendor != blank %}
          <div class="product-rating-row">
            {% if rating != blank %}
              <span class="rating-stars">{{ rating.rating | round: 1 }} / 5</span>
              {% if rating_count != blank %}
                <a href="#reviews">{{ rating_count }} reviews</a>
              {% endif %}
            {% endif %}
            {% if product.vendor != blank %}
              <span class="verified-pill">Sold by {{ product.vendor }}</span>
            {% endif %}
          </div>
        {% endif %}
        <div class="product-summary__price" data-product-price>
          {% render 'price', product: product, use_variant: true %}
        </div>
        {% if product.description != blank %}
          <div class="rte product-summary__description">{{ product.description | strip_html | truncatewords: 42 }}</div>
        {% endif %}

        {% form 'product', product, class: 'product-form' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              <fieldset class="product-option">
                <legend>{{ option.name }}</legend>
                <div class="product-option__values">
                  {% for value in option.values %}
                    <label>
                      <input
                        type="radio"
                        name="options[{{ option.name | escape }}]"
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}
                        data-option-input
                      >
                      <span>{{ value }}</span>
                    </label>
                  {% endfor %}
                </div>
              </fieldset>
            {% endfor %}
          {% endunless %}

          <div class="product-form__row">
            <label class="quantity-field" for="Quantity-{{ section.id }}">
              <span>Qty</span>
              <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1">
            </label>
            <button class="button button--primary button--block" type="submit" {% unless current_variant.available %}disabled{% endunless %} data-add-to-cart>
              {% if current_variant.available %}Add to Basket{% else %}Sold out{% endif %}
            </button>
          </div>
        {% endform %}

        <div class="delivery-panel">
          <strong>Delivery options</strong>
          <div>
            <span class="delivery-badge">Free shipping</span>
            <span>Included on every order, with no minimum spend.</span>
          </div>
          <div>
            <span class="delivery-badge delivery-badge--soft">Secure payment</span>
            <span>Card, accelerated checkout and Shopify payments</span>
          </div>
        </div>

        <div class="product-trust">
          <div>
            <strong>Order updates</strong>
            <span>Receive order and delivery updates after checkout.</span>
          </div>
          <div>
            <strong>Simple returns</strong>
            <span>Return details are provided with your order confirmation.</span>
          </div>
        </div>
      </div>
    </div>

    <div class="product-detail-tabs" id="reviews">
      <details open>
        <summary>Product details</summary>
        <div class="rte">{{ product.description }}</div>
      </details>
      <details>
        <summary>Delivery and returns</summary>
        <p>Free shipping is available on every order. Delivery and return timings can vary by supplier and are confirmed during checkout.</p>
      </details>
    </div>
  </div>

  <script type="application/json" data-product-json>
    {{ product.variants | json }}
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": {{ shop.url | append: product.url | append: '#product' | json }},
      "name": {{ product.title | json }},
      "url": {{ shop.url | append: product.url | json }},
      {% if product.featured_media %}
        "image": {{ product.featured_media.preview_image | image_url: width: 1200 | prepend: 'https:' | json }},
      {% endif %}
      {% if product.description != blank %}
        "description": {{ product.description | strip_html | strip_newlines | json }},
      {% endif %}
      {% if product.vendor != blank %}
        "brand": {
          "@type": "Brand",
          "name": {{ product.vendor | json }}
        },
      {% endif %}
      "offers": [
        {% for variant in product.variants %}
          {
            "@type": "Offer",
            "url": {{ shop.url | append: product.url | append: '?variant=' | append: variant.id | json }},
            "priceCurrency": {{ shop.currency | json }},
            "price": {{ variant.price | divided_by: 100.0 | json }},
            {% if variant.sku != blank %}
              "sku": {{ variant.sku | json }},
            {% endif %}
            "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "itemCondition": "https://schema.org/NewCondition",
            "shippingDetails": {
              "@type": "OfferShippingDetails",
              "shippingDestination": {
                "@type": "DefinedRegion",
                "addressCountry": "GB"
              },
              "shippingRate": {
                "@type": "MonetaryAmount",
                "value": 0,
                "currency": {{ shop.currency | json }}
              }
            }
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "Main product"
}
{% endschema %}
