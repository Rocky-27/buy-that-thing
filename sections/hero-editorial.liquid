<section class="hero-editorial">
  <div class="page-width">
    <div class="hero-editorial__panel">
      <div class="hero-editorial__copy">
        {% if section.settings.eyebrow != blank %}
          <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h1>{{ section.settings.heading }}</h1>
        <p class="hero-editorial__text">{{ section.settings.text }}</p>
        <div class="hero-editorial__actions">
          {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
            <a class="button button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
          {% endif %}
          {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
            <a class="button button--ghost" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
          {% endif %}
        </div>

        <div class="hero-editorial__stats">
          {% for block in section.blocks %}
            <div class="hero-stat" {{ block.shopify_attributes }}>
              <strong>{{ block.settings.value }}</strong>
              <span>{{ block.settings.label }}</span>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="hero-editorial__media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'hero-editorial__image', loading: 'eager' }}
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg hero-editorial__image' }}
        {% endif %}
        <div class="hero-floating-card">
          <p>Daily offer engine</p>
          <strong>{{ section.settings.floating_heading }}</strong>
          <span>{{ section.settings.floating_text }}</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero editorial",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A modern general store"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A professional storefront for high-volume winning products."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Merchandise trending products, move fast on promotions, and keep the shopping experience polished across every category."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop latest products"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Browse collections"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "floating_heading",
      "label": "Floating card heading",
      "default": "Fresh deals every week"
    },
    {
      "type": "text",
      "id": "floating_text",
      "label": "Floating card text",
      "default": "Highlight bundles, limited-time offers, and top-margin categories."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "1,000+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Products ready to scale"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero editorial",
      "blocks": [
        { "type": "stat" },
        { "type": "stat", "settings": { "value": "48h", "label": "Merchandising refresh cadence" } },
        { "type": "stat", "settings": { "value": "4.9/5", "label": "Customer trust presentation" } }
      ]
    }
  ]
}
{% endschema %}
