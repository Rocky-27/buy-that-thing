<section class="hero-editorial">
  <div class="page-width">
    <div class="retail-billboard">
      <div class="retail-billboard__copy">
        <p class="sale-strip">{{ section.settings.eyebrow }}</p>
        <h1>{{ section.settings.heading }}</h1>
        <p>{{ section.settings.text }}</p>
        {% if section.settings.primary_label != blank %}
          <a class="button button--sale" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }}</a>
        {% endif %}
      </div>

      <div class="retail-billboard__products" aria-label="Featured offer products" data-randomized-listing data-visible-count="3">
        {% assign offer_collection = section.settings.offer_collection | default: collections.all %}
        {% if offer_collection != blank and offer_collection.products.size > 0 %}
          {% assign billboard_products_shown = 0 %}
          {% assign billboard_candidates_rendered = 0 %}
          {% assign billboard_candidates_limit = 9 %}
          {% assign billboard_candidate_total = offer_collection.all_products_count | default: offer_collection.products_count %}
          {% assign billboard_candidate_window = billboard_candidate_total | minus: billboard_candidates_limit %}
          {% if billboard_candidate_window < 0 %}
            {% assign billboard_candidate_window = 0 %}
          {% endif %}
          {% assign billboard_random_seed = 'now' | date: '%s' | plus: section.id.size | plus: 17 %}
          {% assign billboard_offset = 0 %}
          {% if billboard_candidate_window > 0 %}
            {% assign billboard_offset = billboard_random_seed | modulo: billboard_candidate_window %}
          {% endif %}
          {% for product in offer_collection.products limit: billboard_candidates_limit offset: billboard_offset %}
            {% if product.available %}
              <a class="billboard-product" href="{{ product.url }}" data-randomized-item {% if billboard_products_shown >= 3 %}hidden{% endif %}>
                {% if product.featured_media %}
                  {{ product.featured_media | image_url: width: 520 | image_tag: loading: 'eager' }}
                {% endif %}
                <span>{{ product.price | money }}</span>
              </a>
              {% assign billboard_products_shown = billboard_products_shown | plus: 1 %}
              {% assign billboard_candidates_rendered = billboard_candidates_rendered | plus: 1 %}
              {% if billboard_candidates_rendered >= billboard_candidates_limit %}
                {% break %}
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if billboard_candidates_rendered < billboard_candidates_limit %}
            {% for product in offer_collection.products %}
              {% unless product.available %}
                <a class="billboard-product" href="{{ product.url }}" data-randomized-item {% if billboard_products_shown >= 3 %}hidden{% endif %}>
                  {% if product.featured_media %}
                    {{ product.featured_media | image_url: width: 520 | image_tag: loading: 'eager' }}
                  {% endif %}
                  <span>{{ product.price | money }}</span>
                </a>
                {% assign billboard_products_shown = billboard_products_shown | plus: 1 %}
                {% assign billboard_candidates_rendered = billboard_candidates_rendered | plus: 1 %}
                {% if billboard_candidates_rendered >= billboard_candidates_limit %}
                  {% break %}
                {% endif %}
              {% endunless %}
            {% endfor %}
          {% endif %}
        {% elsif section.settings.image != blank %}
          <div class="billboard-product billboard-product--wide">
            {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager' }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Retail billboard",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sale strip",
      "default": "Interesting finds, useful upgrades, odd little winners"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We find the useful stuff, the clever stuff and the occasionally ridiculous stuff"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Shop the things that solve a problem, improve a room or make you say, \"fair enough, that is actually great,\" with free delivery included on every order."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Browse the latest finds"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "collection",
      "id": "offer_collection",
      "label": "Products shown in billboard"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback billboard image"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Quick offer",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Title",
          "default": "House glow-ups"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Subtitle",
          "default": "Storage, lighting and fixes that earn their keep"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Retail billboard",
      "blocks": [
        { "type": "stat" },
        { "type": "stat", "settings": { "value": "Garden goodies", "label": "Patio picks, BBQ bits and sunny-day upgrades" } },
        { "type": "stat", "settings": { "value": "Giftable bits", "label": "Easy wins for birthdays, thank-yous and just because" } },
        { "type": "stat", "settings": { "value": "Bargain braggers", "label": "The deals you will be smug about finding" } }
      ]
    }
  ]
}
{% endschema %}
