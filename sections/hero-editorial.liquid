<section class="hero-editorial">
  <div class="page-width">
    <div class="retail-billboard">
      <div class="retail-billboard__copy">
        <p class="sale-strip">{{ section.settings.eyebrow }}</p>
        <h1>{{ section.settings.heading }}</h1>
        <p>{{ section.settings.text }}</p>
        {% if section.settings.primary_label != blank %}
          <a class="button button--sale" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }}</a>
        {% endif %}
      </div>

      <div class="retail-billboard__products" aria-label="Featured offer products">
        {% assign offer_collection = section.settings.offer_collection | default: collections.all %}
        {% if offer_collection != blank and offer_collection.products.size > 0 %}
          {% for product in offer_collection.products limit: 3 %}
            <a class="billboard-product" href="{{ product.url }}">
              {% if product.featured_media %}
                {{ product.featured_media | image_url: width: 520 | image_tag: loading: 'eager' }}
              {% endif %}
              <span>{{ product.price | money }}</span>
            </a>
          {% endfor %}
        {% elsif section.settings.image != blank %}
          <div class="billboard-product billboard-product--wide">
            {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager' }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="promo-quicklinks">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <strong>{{ block.settings.value }}</strong>
          <span>{{ block.settings.label }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Retail billboard",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sale strip",
      "default": "Fresh bargains added daily"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Big little upgrades for your home, garden and everyday life"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Browse practical crowd-pleasers, clever upgrades and feel-good finds, all with free delivery included on every order."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "See today's best buys"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "collection",
      "id": "offer_collection",
      "label": "Products shown in billboard"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback billboard image"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Quick offer",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Title",
          "default": "House glow-ups"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Subtitle",
          "default": "Storage, lighting and fixes that earn their keep"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Retail billboard",
      "blocks": [
        { "type": "stat" },
        { "type": "stat", "settings": { "value": "Garden goodies", "label": "Patio picks, BBQ bits and sunny-day upgrades" } },
        { "type": "stat", "settings": { "value": "Giftable bits", "label": "Easy wins for birthdays, thank-yous and just because" } },
        { "type": "stat", "settings": { "value": "Bargain braggers", "label": "The deals you will be smug about finding" } }
      ]
    }
  ]
}
{% endschema %}
