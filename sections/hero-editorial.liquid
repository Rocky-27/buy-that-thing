<section class="hero-editorial">
  <div class="page-width">
    <div class="retail-billboard">
      <div class="retail-billboard__copy">
        <p class="sale-strip">{{ section.settings.eyebrow }}</p>
        <h1>{{ section.settings.heading }}</h1>
        <p>{{ section.settings.text }}</p>
        {% if section.settings.primary_label != blank %}
          <a class="button button--sale" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }}</a>
        {% endif %}
      </div>

      <div class="retail-billboard__products" aria-label="Featured offer products" data-randomized-listing data-visible-count="3">
        {% assign offer_collection = section.settings.offer_collection | default: collections.all %}
        {% if offer_collection != blank and offer_collection.products.size > 0 %}
          {% assign billboard_products_shown = 0 %}
          {% assign billboard_candidates_rendered = 0 %}
          {% assign billboard_candidates_limit = 9 %}
          {% for product in offer_collection.products %}
            {% if product.available %}
              <a class="billboard-product" href="{{ product.url }}" data-randomized-item {% if billboard_products_shown >= 3 %}hidden{% endif %}>
                {% if product.featured_media %}
                  {{ product.featured_media | image_url: width: 520 | image_tag: loading: 'eager' }}
                {% endif %}
                <span>{{ product.price | money }}</span>
              </a>
              {% assign billboard_products_shown = billboard_products_shown | plus: 1 %}
              {% assign billboard_candidates_rendered = billboard_candidates_rendered | plus: 1 %}
              {% if billboard_candidates_rendered >= billboard_candidates_limit %}
                {% break %}
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if billboard_candidates_rendered < billboard_candidates_limit %}
            {% for product in offer_collection.products %}
              {% unless product.available %}
                <a class="billboard-product" href="{{ product.url }}" data-randomized-item {% if billboard_products_shown >= 3 %}hidden{% endif %}>
                  {% if product.featured_media %}
                    {{ product.featured_media | image_url: width: 520 | image_tag: loading: 'eager' }}
                  {% endif %}
                  <span>{{ product.price | money }}</span>
                </a>
                {% assign billboard_products_shown = billboard_products_shown | plus: 1 %}
                {% assign billboard_candidates_rendered = billboard_candidates_rendered | plus: 1 %}
                {% if billboard_candidates_rendered >= billboard_candidates_limit %}
                  {% break %}
                {% endif %}
              {% endunless %}
            {% endfor %}
          {% endif %}
        {% elsif section.settings.image != blank %}
          <div class="billboard-product billboard-product--wide">
            {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager' }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Retail billboard",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sale strip",
      "default": "Curated from all over | Practical picks | Unexpected favourites"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A broad, carefully chosen mix of useful home finds, clever upgrades and things with a bit more character"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We pull together products from a wide range of suppliers so you can browse one thoughtful edit of practical buys, quirky discoveries and everyday things worth bringing home."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Explore the latest picks"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "collection",
      "id": "offer_collection",
      "label": "Products shown in billboard"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback billboard image"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Quick offer",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Title",
          "default": "House glow-ups"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Subtitle",
          "default": "Storage, lighting and fixes that earn their keep"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Retail billboard",
      "blocks": [
        { "type": "stat" },
        { "type": "stat", "settings": { "value": "Garden bits", "label": "Outdoor pieces, seasonal fixes and patio-friendly upgrades" } },
        { "type": "stat", "settings": { "value": "Giftable finds", "label": "The useful, the odd and the easy wins for other people" } },
        { "type": "stat", "settings": { "value": "Smart buys", "label": "Well-priced finds that still feel like a good spot" } }
      ]
    }
  ]
}
{% endschema %}
