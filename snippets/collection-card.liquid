{% assign collection_url = custom_url | default: routes.all_products_collection_url %}
{% assign collection_count = custom_count | default: 0 %}
{% assign card_title = custom_title %}
{% assign card_text = custom_text %}
{% assign card_cta = custom_cta | default: 'See the picks' %}
{% if collection != blank %}
  {% assign collection_url = collection.url %}
  {% assign collection_count = collection.products_count %}
  {% if card_title == blank %}
    {% assign card_title = collection.title %}
  {% endif %}
  {% if card_text == blank %}
    {% assign card_text = collection.description | strip_html | truncatewords: 16 %}
  {% endif %}
{% else %}
  {% assign card_title = card_title | default: 'Shop everything' %}
  {% assign card_text = card_text | default: 'Jump straight into the full edit of useful finds and feel-good deals.' %}
{% endif %}
<article class="collection-card">
  <a class="collection-card__link" href="{{ collection_url }}">
    <div class="collection-card__media">
      {% if collection != blank and collection.featured_image %}
        {{ collection.featured_image | image_url: width: 1200 | image_tag: class: 'collection-card__image', loading: 'lazy' }}
      {% elsif collection != blank and collection.products.first.featured_media %}
        {{ collection.products.first.featured_media | image_url: width: 1200 | image_tag: class: 'collection-card__image', loading: 'lazy' }}
      {% endif %}
    </div>
    <div class="collection-card__content">
      <p class="section-eyebrow">{{ collection_count }} finds</p>
      <h3>{{ card_title | default: 'Shop the spotlight' }}</h3>
      {% if card_text != blank %}
        <p>{{ card_text }}</p>
      {% endif %}
      <span>{{ card_cta }}</span>
    </div>
  </a>
</article>
