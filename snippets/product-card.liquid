{% assign card_variant = product.selected_or_first_available_variant %}
{% assign rating = product.metafields.reviews.rating.value %}
{% assign rating_count = product.metafields.reviews.rating_count.value %}
{% assign savings = product.compare_at_price_max | minus: product.price %}
{% assign vendor_normalized = product.vendor | downcase | strip | replace: '-', '' | replace: '_', '' | replace: '.', '' | replace: ' ', '' %}
{% assign product_card_url = product.url %}
{% if collection %}
  {% assign product_card_url = product.url | within: collection %}
{% endif %}
{% assign hide_vendor = false %}
{% if vendor_normalized == blank or vendor_normalized == 'unbranded' or vendor_normalized == 'na' or vendor_normalized == 'none' or vendor_normalized == 'unknown' or vendor_normalized == 'generic' or vendor_normalized == 'novendor' %}
  {% assign hide_vendor = true %}
{% endif %}

<article class="product-card" data-product-handle="{{ product.handle }}">
  <a class="product-card__image-link" href="{{ product_card_url }}" data-product-link>
    {% if product.featured_media %}
      {{ product.featured_media | image_url: width: 900 | image_tag: class: 'product-card__image', loading: 'lazy' }}
    {% endif %}
    {% if product.compare_at_price_max > product.price %}
      <span class="product-badge">Save {{ savings | money }}</span>
    {% endif %}
  </a>

  <div class="product-card__content">
    {% unless product.has_only_default_variant %}
      {% assign preview_option = product.options_with_values.first %}
      {% if preview_option.values.size > 0 %}
        <div class="variant-preview" aria-label="{{ preview_option.name }}">
          <span>{{ preview_option.name }}</span>
          <div>
            {% for value in preview_option.values limit: 4 %}
              <a href="{{ product_card_url }}" title="{{ value | escape }}" data-label="{{ value | escape }}" data-product-link>{{ value }}</a>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% else %}
      <div class="variant-preview variant-preview--empty" aria-hidden="true"></div>
    {% endunless %}

    <div class="product-card__header">
      {% unless hide_vendor %}
        <p class="product-card__vendor">{{ product.vendor }}</p>
      {% endunless %}
      <h3><a href="{{ product_card_url }}" data-product-link>{{ product.title }}</a></h3>
    </div>

    {% if rating != blank %}
      <div class="product-card__rating">
        <span>{{ rating.rating | round: 1 }} / 5</span>
        {% if rating_count != blank %}
          <small>({{ rating_count }})</small>
        {% endif %}
      </div>
    {% else %}
      <div class="product-card__rating product-card__rating--empty" aria-hidden="true"></div>
    {% endif %}

    <div class="product-card__price">
      {% render 'price', product: product %}
    </div>

    <div class="delivery-lines">
      <span>Free delivery</span>
      <strong>No minimum spend, no nasty surprises</strong>
    </div>

    {% form 'product', product, class: 'product-card__form' %}
      {% if product.variants.size > 1 %}
        <label class="card-variant-select">
          <span>Pick your option</span>
          <select name="id">
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                {% if variant.id == card_variant.id %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}
              >
                {{ variant.title }}{% unless variant.available %} - Sold out{% endunless %}
              </option>
            {% endfor %}
          </select>
        </label>
      {% else %}
        <input type="hidden" name="id" value="{{ card_variant.id }}">
      {% endif %}
      <button class="product-card__basket" type="submit" {% unless product.available %}disabled{% endunless %}>
        {% if product.available %}Add to basket{% else %}Sold out{% endif %}
      </button>
    {% endform %}
  </div>
</article>
